 497               	;used registers          : R18, R19, R20, R22, R24, R25, R26(XL), R27(XH), R30(ZL), R31(ZH)    
 498               	;arg registers           : R25:R24(FuncPtr), R22(TaskPriority)                                 
 499               	;return registers        : None                                                                
 500               	;unsafe access registers : R18, R19, R20, R22, R24, R25, R26(XL), R27(XH), R30(ZL), R31(ZH)    
 501               	Kernel_Task_Create:                                       ;total 21.50uS @8MHz    (172 clocks) 
 502:kernel.S      ****         KER_PUSH_MSP_ZP                                   ;push MSP and ZP        ( 18 clocks) 
 503               			;set priority to KerSchPr+task_id                                                      
 504:kernel.S      **** 		LDI   R30                , lo8(KerSchPr)          ;load low byte          (  1 clock ) 
 505:kernel.S      **** 		LDI   R31                , hi8(KerSchPr)          ;load high byte         (  1 clock ) 
 506:kernel.S      **** 		KER_CALC_ADDR_OFF_BYTES                           ;calc offset            (  5 clocks) 
 507:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 508               			;set task status to KerSchSts+task_id                                                  
 509:kernel.S      **** 		LDI   R30                , lo8(KerSchSts)         ;load low byte          (  1 clock ) 
 510:kernel.S      **** 		LDI   R31                , hi8(KerSchSts)         ;load high byte         (  1 clock ) 
 511:kernel.S      **** 		KER_CALC_ADDR_OFF_BYTES                           ;calc offset            (  5 clocks) 
 512:kernel.S      **** 		LDI   R18                , TASK_READY             ;set status as ready    (  1 clock ) 
 513:kernel.S      **** 		ST    Z                  , R18                    ;save status            (  2 clocks) 
 514               			;stack pointer for current task (KerStack + KER_STK_SZ*(task_id+1) - 1) ->stack top    
 515:kernel.S      **** 		LDS   R18                , KerBase+OFB_TID        ;load task_id           (  2 clocks) 
 516:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 517:kernel.S      **** 		LDI   R19                , KER_STK_SZ             ;load stack size        (  1 clock ) 
 518:kernel.S      **** 		MUL   R18                , R19                    ;multiply to get offset (  2 clocks) 
 519:kernel.S      **** 		MOV   R30                , R0                     ;load multiplied low    (  1 clocks) 
 520:kernel.S      **** 		MOV   R31                , R1                     ;load multiplied high   (  1 clocks) 
 521:kernel.S      **** 		SBIW  R30                , 0x01                   ;dec multiplied val-1   (  2 clocks) 
 522:kernel.S      **** 		CLR   R1                                          ;gcc expects cleared    (  1 clock ) 
 523:kernel.S      **** 		LDI   R18                , lo8(KerStack)          ;load base addr low     (  1 clock ) 
 524:kernel.S      **** 		LDI   R19                , hi8(KerStack)          ;load base addr high    (  1 clock ) 
 525:kernel.S      **** 		ADD   R30                , R18                    ;add low bytes          (  1 clock ) 
 526:kernel.S      **** 		ADC   R31                , R19                    ;add high bytes+carry   (  1 clock ) 
 527:kernel.S      **** 		OUT   IOSPL              , R30                    ;load SPL               (  1 clock ) 
 528:kernel.S      ****         OUT   IOSPH              , R31                    ;load SPH               (  1 clock ) 
 529               			;function argument directly returns word address                                       
 530:kernel.S      **** 	    PUSH  R24                                         ;push word addr low     (  2 clocks) 
 531:kernel.S      **** 		PUSH  R25                                         ;push word addr high    (  2 clocks) 
 532               			;push context to stack of this task                                                    
 533:kernel.S      **** 		KER_CONTEXT_SAVE_HANDLER                          ;save context           ( 68 clocks) 
 534               			;read stack pointer of current task (necessary when restore)                           
 535:kernel.S      **** 		IN    R18                , IOSPL                  ;read SPL               (  1 clock ) 
 536:kernel.S      ****         IN    R19                , IOSPH                  ;read SPH               (  1 clock ) 
 537               			;calculate the address where current task's SP will be stored and store SP             
 538:kernel.S      **** 		LDS   R20                , KerBase+OFB_TID        ;load task_id           (  2 clocks) 
 539:kernel.S      **** 		LSL   R20                                         ;left shift to multiply (  1 clock ) 
 540:kernel.S      **** 		LDI   R30                , lo8(KerPSP)            ;fetch base pos low     (  1 clock ) 
 541:kernel.S      **** 		LDI   R31                , hi8(KerPSP)            ;fetch base pos high    (  1 clock ) 
 542:kernel.S      **** 		ADD   R30                , R20                    ;add offset to array    (  1 clock ) 
 543:kernel.S      **** 		LDI   R20                , 0x00                   ;clear reg              (  1 clock ) 
 544:kernel.S      **** 		ADC   R31                , R20                    ;add carry if any       (  1 clock ) 
 545:kernel.S      **** 		ST    Z+                 , R18                    ;SPL at KerPSp+offset   (  2 clocks) 
 546:kernel.S      **** 		ST    Z                  , R19                    ;SPH at KerPSp+offset   (  2 clocks) 
 547               			;increment task_id                                                                     
 548:kernel.S      **** 		LDS   R18                , KerBase+OFB_TID        ;load task_id           (  2 clocks) 
 549:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 550:kernel.S      **** 		STS   KerBase+OFB_TID    , R18                    ;store task_id          (  2 clocks) 
 551               			;increment ntask                                                                       
 552:kernel.S      **** 		LDS   R18                , KerBase+OFB_NTSK       ;load ntask             (  2 clocks) 
 553:kernel.S      **** 		INC   R18                                         ;increment ntask        (  1 clock ) 
 554:kernel.S      **** 		STS   KerBase+OFB_NTSK   , R18                    ;store ntask            (  2 clocks) 
 555:kernel.S      **** 		KER_POP_MSP_ZP                                    ;pop MSP and ZP         ( 18 clocks) 
 556:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
 557               	;;==================================kernel task create end==================================;; 
