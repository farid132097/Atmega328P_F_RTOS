 623               	;unsafe access registers : R18, R19, R30(ZL), R31(ZH)                                          
 624               	.macro  KER_LOAD_TASK_ID_AND_SP                           ;total 1.75uS @8MHz     ( 14 clocks) 
 625               			LDI   R30                , lo8(KerPSP)            ;fetch base pos low     (  1 clock ) 
 626               			LDI   R31                , hi8(KerPSP)            ;fetch base pos high    (  1 clock ) 
 627               			KER_CALC_ADDR_OFF_WORD                            ;calc offset            (  6 clocks) 
 628               			LDD   R18                , Z+0                    ;load SPL at ZP         (  2 clocks) 
 629               			LDD   R19                , Z+1                    ;load SPH at ZP         (  2 clocks) 
 630               			OUT   IOSPL              , R18                    ;load SPL0              (  1 clock ) 
 631               			OUT   IOSPH              , R19                    ;load SPH0              (  1 clock ) 
 632               	.endm                                                                                          
 633               	;;=================================load task id & sp end====================================;; 
