 386               	
 387               	.macro  KER_RUN_SCHEDULER                                 ;total 0.25uS @8MHz     (  2 clocks) 
 388               			LDS   R18                , KerTID                 ;load val               (  2 clocks) 
 389               			LDS   R19                , KerNTSK                ;load ntask             (  2 clocks) 
 390               			
 391               			LDI   R20                , 0x01                   ;set val                (  1 clock ) 
 392               			ADD   R18                , R20                    ;increment val          (  1 clock ) 
 393               			CP    R18                , R19                    ;compare val            (  1 clock ) 
 394               			BRLO  _KER_SCH_ASSN\@
 395               			LDI   R18                , 0x00                   ;roll back              (  1 clock ) 
 396               		_KER_SCH_ASSN\@:
 397               		    STS   KerTID             , R18                    ;save val               (  2 clocks)  
 398               	
 399               			LDI   R30                , lo8(KerSleep)          ;load sleep reg low     (  1 clock ) 
 400               			LDI   R31                , hi8(KerSleep)          ;load sleep reg high    (  1 clock ) 
 401               			ADD   R30                , R18                    ;add                    (  1 clock ) 
 402               			LDI   R18                , 0x00                   ;set val 0              (  1 clock ) 
 403               			ADC   R31                , R18                    ;add with carry         (  1 clock ) 
 404               			LD    R18                , Z                      ;load val               (  1 clock ) 
 405               			STS   KerLST             , R18                    ;store val              (  2 clocks) 
 406               	.endm                                                                                          
