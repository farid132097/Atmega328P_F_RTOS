 685               	;;============================sleep timeout management starting=============================;; 
 686               	;used registers          : R18, R19, R20, R24, R30(ZL), R31(ZH)                                
 687               	;arg registers           : R24 (SCH_MODE_HANDLER/SCH_MODE_THREAD)                              
 688               	;return registers        : R24 (READY/BLOCKED/EXECUTING/SUSPENDED/CONS_LAT)                    
 689               	;unsafe access registers : R18, R19, R20, R24, R30(ZL), R31(ZH)                                
 690               	.macro  KER_SLP_TIME_MGNT                                 ;total 6.50uS @8MHz     ( 52 clocks) 
 691               			LDI   R30                , lo8(KerSchSlp)         ;fetch base pos low     (  1 clock ) 
 692               			LDI   R31                , hi8(KerSchSlp)         ;fetch base pos high    (  1 clock ) 
 693               			KER_CALC_ADDR_OFF_WORD                            ;calc offset            (  6 clocks) 
 694               			;fetch current value from ram, if val=0, skip decrement                                
 695               	        LDD   R18                , Z+0                    ;load val low byte      (  2 clocks) 
 696               			TST   R18                                         ;check if zero          (  1 clock ) 
 697               			BREQ  _VAL_NULL\@                                 ;val=0, save sts        (  2 clocks) 
 698               	        CPI   R24                , SCH_MODE_THREAD        ;if arg=1, thread mode  (  1 clock ) 
 699               			BREQ  _VAL_NOT_NULL\@                             ;no need to dec val     (  2 clocks) 
 700               			;R19:R18 contains 16 bit sleep timer val, decrease val by 1                            
 701               			LDI   R19                , 0x01                   ;set val 1              (  1 clock ) 
 702               	        SUB   R18                , R19                    ;subtract low byte      (  1 clock ) 
 703               			;store new value                                                                       
 704               			STD   Z+0                , R18                    ;store low byte         (  2 clocks) 
 705               			TST   R18                                         ;check if zero          (  1 clock ) 
 706               			BRNE  _VAL_NOT_NULL\@                             ;val!=0                 (  2 clocks) 
 707               		_VAL_NULL\@:                                                                               
 708               		    ;find ram address for status                                                           
 709               		    LDI   R30                , lo8(KerSchSts)         ;fetch base pos low     (  1 clock ) 
 710               			LDI   R31                , hi8(KerSchSts)         ;fetch base pos high    (  1 clock ) 
 711               	        KER_CALC_ADDR_OFF_BYTES                           ;calc offset            (  5 clocks) 
 712               			;update flag as task is ready                                                          
 713               			LDI   R24                , TASK_READY             ;set TASK_READY         (  1 clock ) 
 714               			ST    Z                  , R24                    ;update flag            (  2 clocks) 
 715               			RJMP  _EXIT_SLP_TIME\@                            ;jump to exit           (  2 clocks) 
 716               	    _VAL_NOT_NULL\@:                                                                           
 717               		    LDI   R30                , lo8(KerSchSts)         ;fetch base pos low     (  1 clock ) 
 718               			LDI   R31                , hi8(KerSchSts)         ;fetch base pos high    (  1 clock ) 
 719               	        KER_CALC_ADDR_OFF_BYTES                           ;calc offset            (  5 clocks) 
 720               		    LD    R24                , Z                      ;return sts             (  2 clocks) 
 721               	    _EXIT_SLP_TIME\@:                                                                          
 722               	.endm                                                                                          
 723               	;;============================sleep timeout management end==================================;; 
 724               	
