 427               	.macro KER_DISABLE_ANALOG_DOMAIN                          ;total 0.75uS @8MHz     ( 10 clocks) 
 428               	    #if defined(KER_IDLE_AS_SLEEP)
 429               			LDS   R18                , SRADCSRA               ;load ADCSRA            (  2 clocks) 
 430               			ANDI  R18                , 0x7F                   ;clear ADEN             (  1 clock ) 
 431               			STS   SRADCSRA           , R18                    ;set val                (  2 clocks) 
 432               			LDS   R18                , SRACSR                 ;load ACSR              (  2 clocks) 
 433               			ORI   R18                , 0x80                   ;set ACD                (  1 clock ) 
 434               			STS   SRACSR             , R18                    ;set val                (  2 clocks) 
 435               		#endif                                                                                     
 436               	.endm                                                                                          
