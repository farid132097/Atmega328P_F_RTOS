 534               	Kernel_Vars_Init:                                         ;total 1.875uS @8MHz    ( 15 clocks) 
 535:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 536:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 537:kernel.S      **** 		STS   KerHPTID           , R18                    ;store hi prio task_id  (  2 clocks) 
 538:kernel.S      **** 		STS   KerNTSK            , R18                    ;store ntask            (  2 clocks) 
 539:kernel.S      **** 		STS   KerLST             , R18                    ;store lowest sleep dur (  2 clocks) 
 540:kernel.S      **** 		STS   KerSCHM            , R18                    ;store scheduler mode   (  2 clocks) 
 541:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
