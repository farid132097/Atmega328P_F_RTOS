 168               	.macro  KER_TIMER_INIT                                    ;~9.13uS @8MHz          (~73 clocks) 
 169               			KER_INTERRUPT_STATE_SAVE                          ;save interrupt state   (  3 clocks) 
 170               	        CLI                                               ;disable interrupts     (  1 clock ) 
 171               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 172               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 173               			STS   SRTCCR2A           , R18                    ;set val to TCCR2A      (  2 clocks) 
 174               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 175               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 176               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 177               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 178               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 179               			LDI   R18                , 0x03                   ;prescaler 32           (  1 clock ) 
 180               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 181               		KER_TCR2AUB\@:                                                                             
 182               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 183               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 184               			BRNE  KER_TCR2AUB\@                               ;wait until AUB cleared (  2 clocks) 
 185               		KER_TCR2BUB\@:                                                                             
 186               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 187               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 188               			BRNE  KER_TCR2BUB\@                               ;wait until BUB cleared (  2 clocks) 
 189               		KER_TCN2UB\@:                                                                              
 190               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 191               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 192               			BRNE  KER_TCN2UB\@                                ;wait until UB cleared  (  2 clocks) 
 193               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 194               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 195               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 196               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 197               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 198               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 199               			KER_INTERRUPT_STATE_RESTORE                       ;restore interrupt      (  5 clocks) 
 200               	.endm                                                                                          
