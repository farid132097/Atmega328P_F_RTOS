 108               	;;=================================timer2 disable starting==================================;; 
 109               	;used registers          : R18                                                                 
 110               	;arg registers           : None                                                                
 111               	;return registers        : None                                                                
 112               	;unsafe access registers : R18                                                                 
 113               	.macro  KER_TIMER2_DISABLE                                ;1.75uS @8MHz           ( 14 clocks) 
 114               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 115               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 116               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 117               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 118               			STS   SROCR2B            , R18                    ;clear OCR2B            (  2 clocks) 
 119               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 120               	.endm                                                                                          
 121               	;;==================================timer2 disable end======================================;; 
