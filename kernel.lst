 442               	.macro KER_ENTER_SLEEP                                    ;total 0.75uS @8MHz     (  6 clocks) 
 443               	    #ifdef KER_IDLE_AS_SLEEP                                                                   
 444               			LDS   R18                , SRSMCR                 ;load SMCR              (  2 clocks) 
 445               			ORI   R18                , 0x01                   ;set SE bit             (  1 clock ) 
 446               			STS   SRSMCR             , R18                    ;set val                (  2 clocks) 
 447               			SLEEP                                             ;sleep cpu              (  1 clock ) 
 448               		#endif                                                                                     
 449               	.endm                                                                                          
