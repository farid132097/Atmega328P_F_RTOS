 109               	;;=================================timer2 disable starting==================================;; 
 110               	;used registers          : R18                                                                 
 111               	;arg registers           : None                                                                
 112               	;return registers        : None                                                                
 113               	;unsafe access registers : R18                                                                 
 114               	.macro  KER_TIMER2_DISABLE                                ;1.75uS @8MHz           ( 14 clocks) 
 115               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 116               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 117               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 118               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 119               			STS   SROCR2B            , R18                    ;clear OCR2B            (  2 clocks) 
 120               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 121               	.endm                                                                                          
 122               	;;==================================timer2 disable end======================================;; 
