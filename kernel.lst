 392               	.macro  KER_LOAD_TASK_ID_AND_SP                           ;total 1.75uS @8MHz     ( 14 clocks) 
 393               			LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 394               			LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 395               			LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 396               			LSL   R18                                         ;left shift to multiply (  1 clock ) 
 397               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 398               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 399               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 400               			LDD   R18                , Z+0                    ;load SPL at ZP         (  2 clocks) 
 401               			LDD   R19                , Z+1                    ;load SPH at ZP         (  2 clocks) 
 402               			OUT   IOSPL              , R18                    ;load SPL0              (  1 clock ) 
 403               			OUT   IOSPH              , R19                    ;load SPH0              (  1 clock ) 
 404               	.endm                                                                                          
