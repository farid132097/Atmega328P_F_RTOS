 430               	.macro  KER_RESTORE_R0_SREG                               ;total 0.63uS @8MHz     (  5 clocks) 
 431               	        POP   R0                                          ;fetch SREG             (  2 clocks) 
 432               			OUT   IOSREG             , R0                     ;load SREG              (  1 clock ) 
 433               			POP   R0                                          ;restore R0             (  2 clocks) 
 434               	.endm                                                                                          
