 377               	.macro  KER_MSP_ZP_RESTORE                                ;total 1.25uS @8MHz     ( 10 clocks) 
 378               			LDS   R31                , KerMSPZP+3             ;fetch ZH               (  2 clocks) 
 379               			LDS   R30                , KerMSPZP+2             ;fetch ZL               (  2 clocks) 
 380               			LDS   R19                , KerMSPZP+1             ;fetch SPH              (  2 clocks) 
 381               			LDS   R18                , KerMSPZP+0             ;fetch SPL              (  2 clocks) 
 382               			OUT   IOSPL              , R18                    ;load SPL               (  1 clock ) 
 383               			OUT   IOSPH              , R19                    ;load SPH               (  1 clock ) 
 384               	.endm                                                                                          
