 490               	Kernel_Timer_Init:                                        ;total 11.50uS @8MHz    ( 92 clocks) 
 491:kernel.S      **** 		KER_DEBUG_PIN_INIT                                ;debug pin init         (  4 clocks) 
 492:kernel.S      **** 		KER_TIMER_INIT                                    ;init timer             (          ) 
 493:kernel.S      **** 		KER_SLEEP_INIT                                    ;sleep init
 494:kernel.S      **** 		SEI
 495:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
 496               	
