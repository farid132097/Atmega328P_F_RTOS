 407               	.global  __vector_9                                                                            
 408               	    __vector_9:                                           ;total 40.00uS @8MHz    (344 clocks) 
 409:kernel.S      **** 	    KER_DEBUG_PIN_SET                                 ;debug pin set          (  2 clocks) 
 410:kernel.S      **** 		KER_CONTEXT_SAVE                                  ;save context           (          ) 
 411:kernel.S      ****         KER_TIMER_RELOAD                                  ;reload timer           (  4 clocks) 
 412:kernel.S      **** 		KER_CONTEXT_RESTORE                               ;restore context        (          ) 
