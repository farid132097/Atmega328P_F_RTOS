 866               			LDI   R18                , 0x04                   ;set SM[2:0] val        (  1 clock ) 
 867               	        #elif defined(KER_SLEEP_MODE_POWER_SAVE)                                               
 868               			LDI   R18                , 0x06                   ;set SM[2:0] val        (  1 clock ) 
 869               			#else                                                                                  
