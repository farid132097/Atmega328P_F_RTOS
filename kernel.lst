 413               	.macro KER_DISABLE_ANALOG_DOMAIN                          ;total 0.75uS @8MHz     ( 10 clocks) 
 414               	    #if defined(KER_IDLE_AS_SLEEP)
 415               			LDS   R18                , SRADCSRA               ;load ADCSRA            (  2 clocks) 
 416               			ANDI  R18                , 0x7F                   ;clear ADEN             (  1 clock ) 
 417               			STS   SRADCSRA           , R18                    ;set val                (  2 clocks) 
 418               			LDS   R18                , SRACSR                 ;load ACSR              (  2 clocks) 
 419               			ORI   R18                , 0x80                   ;set ACD                (  1 clock ) 
 420               			STS   SRACSR             , R18                    ;set val                (  2 clocks) 
 421               		#endif                                                                                     
 422               	.endm                                                                                          
