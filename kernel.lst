 160               	.macro  KER_TIMER_RELOAD                                  ;0.75uS @8MHz           (  6 clocks) 
 161               	        LDS   R18                , KerLST                 ;fetch lowst sleep time (  2 clocks) 
 162               			CPI   R18                , 0x15                   ;compare with 21        (  1 clock ) 
 163               			BRCS  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 164               			CPI   R18                , 0x3F                   ;compare with 63        (  1 clock ) 
 165               			BRCC  _KER_TIMER_RLD_CMP105\@                     ;jmp to label           (  2 clocks) 
 166               			SUBI  R18                , 0xFF                   ;add 1                  (  1 clock ) 
 167               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 168               		_KER_TIMER_RLD_CMP105\@:
 169               			CPI   R18                , 0x69                   ;compare with 105       (  1 clock ) 
 170               			BRCC  _KER_TIMER_RLD_CMP146\@                     ;jmp to label           (  2 clocks) 
 171               			SUBI  R18                , 0xFE                   ;add 2                  (  1 clock ) 
 172               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 173               		_KER_TIMER_RLD_CMP146\@:
 174               			CPI   R18                , 0x92                   ;compare with 146       (  1 clock ) 
 175               			BRCC  _KER_TIMER_RLD_CMP188\@                     ;jmp to label           (  2 clocks) 
 176               			SUBI  R18                , 0xFD                   ;add 3                  (  1 clock ) 
 177               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 178               		_KER_TIMER_RLD_CMP188\@:
 179               			CPI   R18                , 0xBC                   ;compare with 188       (  1 clock ) 
 180               			BRCC  _KER_TIMER_RLD_CMP230\@                     ;jmp to label           (  2 clocks) 
 181               			SUBI  R18                , 0xFC                   ;add 4                  (  1 clock ) 
 182               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 183               		_KER_TIMER_RLD_CMP230\@:
 184               			CPI   R18                , 0xE6                   ;compare with 230       (  1 clock ) 
 185               			BRCC  _KER_TIMER_RLD_ELSE\@                       ;jmp to label           (  2 clocks) 
 186               			SUBI  R18                , 0xFB                   ;add 5                  (  1 clock ) 
 187               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 188               		_KER_TIMER_RLD_ELSE\@:
 189               			SUBI  R18                , 0xFA                   ;add 6                  (  1 clock ) 
 190               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 191               		_KER_TIMER_LOAD_TCNT2\@:
 192               			NEG   R18                                         ;256-val                (  1 clock ) 
 193               			STS   SRTCNT2            , R18                    ;set val                (  2 clocks) 
 194               		_KER_TIMER_LOAD_BSY\@:
 195               	        LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 196               			SBRC  R18                , 0x04                   ;check bit4 TCN2UB      (  2 clocks) 
 197               			RJMP  _KER_TIMER_LOAD_BSY\@                       ;jmp to label           (  2 clocks) 
 198               			LDI   R18                , 0x01                   ;load val               (  1 clock ) 
 199               			STS   SRTIFR2            , R18                    ;store val              (  2 clocks) 
 200               			STS   SRTIMSK2           , R18                    ;store val              (  2 clocks) 
 201               	.endm                                                                                          
