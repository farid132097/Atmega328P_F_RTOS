1125:kernel.S      **** Kernel_Task_Sleep:                                        ;total 37.25uS @8MHz    (298 clocks) 
1126:kernel.S      ****         ;save current context                                                                  
1127:kernel.S      ****         KER_CONTEXT_SAVE_THREAD                           ;save context           ( 69 clocks) 
1128:kernel.S      **** 		KER_SAVE_CURR_TASK_SP                             ;save current task SP   ( 14 clocks) 
 1129               			;create next task wakeup time (args R25:R24)                                           
 1130               			LDI   R30                , lo8(KerSchSlp)         ;load low byte          (  1 clock ) 
 1131               			LDI   R31                , hi8(KerSchSlp)         ;load high byte         (  1 clock ) 
 1132               			KER_CALC_ADDR_OFF_WORD                            ;offset calc            (  6 clocks) 
 1133               			STD   Z+0                , R24                    ;save sleep time low    (  2 clocks) 
 1134               			STD   Z+1                , R25                    ;save sleep time high   (  2 clocks) 
 1135               			;update task scheduler status as blocked                                               
 1136               			LDI   R30                , lo8(KerSchSts)         ;load low byte          (  1 clock ) 
 1137               			LDI   R31                , hi8(KerSchSts)         ;load high byte         (  1 clock ) 
 1138               			KER_CALC_ADDR_OFF_BYTES                           ;offset calc            (  5 clocks) 
 1139               	        LDI   R18                , TASK_BLOCKED           ;block task until cnt=0 (  1 clock ) 
 1140               			STD   Z+0                , R18                    ;save block flag        (  2 clocks) 
 1141               			;run scheduler, load next task sp, restore context                                     
1142:kernel.S      **** 		LDI    R24               , SCH_MODE_THREAD        ;set sch mode           (  1 clock ) 
1143:kernel.S      **** 		KER_RUN_SCHEDULER                                 ;run scheduler          (106 clocks) 
 1144               			KER_LOAD_TASK_ID_AND_SP                           ;load next task id, SP  ( 14 clocks) 
1145:kernel.S      **** 		KER_CONTEXT_RESTORE_THREAD                        ;restore context        ( 68 clocks) 
1146:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
1147:kernel.S      **** ;;=================================kernel task sleep end====================================;; 
