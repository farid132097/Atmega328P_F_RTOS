 552               	;arg registers           : R30(ZL), R31(ZH)                                                    
 553               	;return registers        : R30(ZL), R31(ZH)                                                    
 554               	;unsafe access registers : R18, R30(ZL), R31(ZH)                                               
 555               	.macro  KER_CALC_ADDR_OFF_BYTES                           ;total 0.63uS @8MHz     (  5 clocks) 
 556               	        LDS   R18                , KerBase+OFB_TID        ;fetch task_id          (  2 clocks) 
 557               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 558               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 559               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 560               	.endm                                                                                          
