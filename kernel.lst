 146               	.macro  KER_INTERRUPT_STATE_SAVE                          ;total 0.375uS @8MHz    (  3 clocks) 
 147               	        IN    R18                , IOSREG                 ;load val               (  1 clock ) 
 148               			STS   KerINTST           , R18                    ;store val              (  2 clocks) 
 149               	.endm                                                                                          
