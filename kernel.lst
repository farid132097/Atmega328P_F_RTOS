 501               	Kernel_Task_Create:                                       ;total 21.50uS @8MHz    (172 clocks) 
 502:kernel.S      **** 		KER_MSP_ZP_SAVE                                   ;push MSP and ZP        ( 18 clocks) 
 503               			;set priority to KerPrio+task_id                                                       
 504:kernel.S      **** 		LDI   R30                , lo8(KerPrio)           ;load low byte          (  1 clock ) 
 505:kernel.S      **** 		LDI   R31                , hi8(KerPrio)           ;load high byte         (  1 clock ) 
 506:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 507:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 508:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 509:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 510:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 511               	
 512               			;set task status to KerSleep+task_id                                                  
 513:kernel.S      **** 		LDI   R30                , lo8(KerSleep)          ;load low byte          (  1 clock ) 
 514:kernel.S      **** 		LDI   R31                , hi8(KerSleep)          ;load high byte         (  1 clock ) 
 515:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 516:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 517:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 518:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 519:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 520:kernel.S      **** 		LDI   R18                , 0x00                   ;set sleep time->ready  (  1 clock ) 
 521:kernel.S      **** 		ST    Z                  , R18                    ;save status            (  2 clocks) 
 522               	
 523               			;stack pointer for current task (KerStack + KER_STK_SZ*(task_id+1) - 1) ->stack top    
 524:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 525:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 526:kernel.S      **** 		LDI   R19                , KER_STK_SZ             ;load stack size        (  1 clock ) 
 527:kernel.S      **** 		MUL   R18                , R19                    ;multiply to get offset (  2 clocks) 
 528:kernel.S      **** 		MOV   R30                , R0                     ;load multiplied low    (  1 clocks) 
 529:kernel.S      **** 		MOV   R31                , R1                     ;load multiplied high   (  1 clocks) 
 530:kernel.S      **** 		SBIW  R30                , 0x01                   ;dec multiplied val-1   (  2 clocks) 
 531:kernel.S      **** 		CLR   R1                                          ;gcc expects cleared    (  1 clock ) 
 532:kernel.S      **** 		LDI   R18                , lo8(KerStack)          ;load base addr low     (  1 clock ) 
 533:kernel.S      **** 		LDI   R19                , hi8(KerStack)          ;load base addr high    (  1 clock ) 
 534:kernel.S      **** 		ADD   R30                , R18                    ;add low bytes          (  1 clock ) 
 535:kernel.S      **** 		ADC   R31                , R19                    ;add high bytes+carry   (  1 clock ) 
 536:kernel.S      **** 		OUT   IOSPL              , R30                    ;load SPL               (  1 clock ) 
 537:kernel.S      ****         OUT   IOSPH              , R31                    ;load SPH               (  1 clock ) 
 538               			;function argument directly returns word address                                       
 539:kernel.S      **** 	    PUSH  R24                                         ;push word addr low     (  2 clocks) 
 540:kernel.S      **** 		PUSH  R25                                         ;push word addr high    (  2 clocks) 
 541               			;push context to stack of this task                                                    
 542:kernel.S      **** 		SEI                                               ;enable interrupt       (  1 clock ) 
 543:kernel.S      **** 		KER_CONTEXT_SAVE                                  ;save context           ( 68 clocks) 
 544               			;read stack pointer of current task (necessary when restore)                           
 545:kernel.S      **** 		IN    R18                , IOSPL                  ;read SPL               (  1 clock ) 
 546:kernel.S      ****         IN    R19                , IOSPH                  ;read SPH               (  1 clock ) 
 547               			;calculate the address where current task's SP will be stored and store SP             
 548:kernel.S      **** 		LDS   R20                , KerTID                 ;load task_id           (  2 clocks) 
 549:kernel.S      **** 		LSL   R20                                         ;left shift to multiply (  1 clock ) 
 550:kernel.S      **** 		LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 551:kernel.S      **** 		LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 552:kernel.S      **** 		ADD   R30                , R20                    ;add offset to array    (  1 clock ) 
 553:kernel.S      **** 		LDI   R20                , 0x00                   ;clear reg              (  1 clock ) 
 554:kernel.S      **** 		ADC   R31                , R20                    ;add carry if any       (  1 clock ) 
 555:kernel.S      **** 		ST    Z+                 , R18                    ;SPL at KerTSP+offset   (  2 clocks) 
 556:kernel.S      **** 		ST    Z                  , R19                    ;SPH at KerTSP+offset   (  2 clocks) 
 557               			;increment task_id                                                                     
 558:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 559:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 560:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 561               			;increment ntask                                                                       
 562:kernel.S      **** 		LDS   R18                , KerNTSK                ;load ntask             (  2 clocks) 
 563:kernel.S      **** 		INC   R18                                         ;increment ntask        (  1 clock ) 
 564:kernel.S      **** 		STS   KerNTSK   , R18                             ;store ntask            (  2 clocks) 
 565:kernel.S      **** 		KER_MSP_ZP_RESTORE                                ;pop MSP and ZP         ( 18 clocks) 
 566:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
