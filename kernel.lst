 454               			LDS   R18                , SRADCSRA               ;load ADCSRA            (  2 clocks) 
 455               			ANDI  R18                , 0x7F                   ;clear ADEN             (  1 clock ) 
 456               			STS   SRADCSRA           , R18                    ;set val                (  2 clocks) 
 457               			LDS   R18                , SRACSR                 ;load ACSR              (  2 clocks) 
 458               			ORI   R18                , 0x80                   ;set ACD                (  1 clock ) 
 459               			STS   SRACSR             , R18                    ;set val                (  2 clocks) 
 460               		#endif                                                                                     
