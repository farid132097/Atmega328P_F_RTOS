 208               	.macro  KER_TIMER_RELOAD_MS                               ;0.75uS @8MHz           (  6 clocks) 
 209               	        LDS   R18                , KerLST                 ;fetch lowst sleep time (  2 clocks) 
 210               			CPI   R18                , 0x15                   ;compare with 21        (  1 clock ) 
 211               			BRCS  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 212               			CPI   R18                , 0x3F                   ;compare with 63        (  1 clock ) 
 213               			BRCC  KER_TIMER_RLD_CMP105\@                      ;jmp to label           (  2 clocks) 
 214               			SUBI  R18                , 0xFF                   ;add 1                  (  1 clock ) 
 215               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 216               		KER_TIMER_RLD_CMP105\@:                                                                    
 217               			CPI   R18                , 0x69                   ;compare with 105       (  1 clock ) 
 218               			BRCC  KER_TIMER_RLD_CMP146\@                      ;jmp to label           (  2 clocks) 
 219               			SUBI  R18                , 0xFE                   ;add 2                  (  1 clock ) 
 220               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 221               		KER_TIMER_RLD_CMP146\@:                                                                    
 222               			CPI   R18                , 0x92                   ;compare with 146       (  1 clock ) 
 223               			BRCC  KER_TIMER_RLD_CMP188\@                      ;jmp to label           (  2 clocks) 
 224               			SUBI  R18                , 0xFD                   ;add 3                  (  1 clock ) 
 225               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 226               		KER_TIMER_RLD_CMP188\@:                                                                    
 227               			CPI   R18                , 0xBC                   ;compare with 188       (  1 clock ) 
 228               			BRCC  KER_TIMER_RLD_CMP230\@                      ;jmp to label           (  2 clocks) 
 229               			SUBI  R18                , 0xFC                   ;add 4                  (  1 clock ) 
 230               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 231               		KER_TIMER_RLD_CMP230\@:                                                                    
 232               			CPI   R18                , 0xE6                   ;compare with 230       (  1 clock ) 
 233               			BRCC  KER_TIMER_RLD_ELSE\@                        ;jmp to label           (  2 clocks) 
 234               			SUBI  R18                , 0xFB                   ;add 5                  (  1 clock ) 
 235               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 236               		KER_TIMER_RLD_ELSE\@:                                                                      
 237               			SUBI  R18                , 0xFA                   ;add 6                  (  1 clock ) 
 238               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 239               		KER_TIMER_LOAD_TCNT2\@:                                                                    
 240               			NEG   R18                                         ;256-val                (  1 clock ) 
 241               			STS   SRTCNT2            , R18                    ;set val                (  2 clocks) 
 242               		KER_TIMER_LOAD_BSY\@:                                                                      
 243               	        LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 244               			SBRC  R18                , 0x04                   ;check bit4 TCN2UB      (  2 clocks) 
 245               			RJMP  KER_TIMER_LOAD_BSY\@                        ;jmp to label           (  2 clocks) 
 246               			LDI   R18                , 0x01                   ;load val               (  1 clock ) 
 247               			STS   SRTIFR2            , R18                    ;clear flag             (  2 clocks) 
 248               			STS   SRTIMSK2           , R18                    ;enable ovf interrupt   (  2 clocks) 
 249               	.endm                                                                                          
