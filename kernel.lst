 293               	;;==================================context save starting===================================;; 
 294               	;used registers          : R0~R31                                                              
 295               	;arg registers           : None                                                                
 296               	;return registers        : None                                                                
 297               	;unsafe access registers : None                                                                
 298               	.macro  KER_CONTEXT_SAVE                                  ;total 7.88uS @8MHz     ( 83 clocks) 
 299               	        PUSH  R0                                          ;push R0                (  2 clocks) 
 300               			IN    R0                 , IOSREG                 ;save SREG              (  1 clock ) 
 301               			CLI                                               ;clear interrupt        (  1 clock ) 
 302               			PUSH  R0                                          ;save SREG              (  2 clocks) 
 303               			PUSH  R1                                          ;save R1                (  2 clocks) 
 304               			CLR   R1                                          ;clear R1               (  1 clock ) 
 305               			PUSH  R2                                          ;save R2                (  2 clocks) 
 306               			PUSH  R3                                          ;save R3                (  2 clocks) 
 307               			PUSH  R4                                          ;save R4                (  2 clocks) 
 308               			PUSH  R5                                          ;save R5                (  2 clocks) 
 309               			PUSH  R6                                          ;save R6                (  2 clocks) 
 310               			PUSH  R7                                          ;save R7                (  2 clocks) 
 311               			PUSH  R8                                          ;save R8                (  2 clocks) 
 312               			PUSH  R9                                          ;save R9                (  2 clocks) 
 313               			PUSH  R10                                         ;save R10               (  2 clocks) 
 314               			PUSH  R11                                         ;save R11               (  2 clocks) 
 315               			PUSH  R12                                         ;save R12               (  2 clocks) 
 316               			PUSH  R13                                         ;save R13               (  2 clocks) 
 317               			PUSH  R14                                         ;save R14               (  2 clocks) 
 318               			PUSH  R15                                         ;save R15               (  2 clocks) 
 319               			PUSH  R16                                         ;save R16               (  2 clocks) 
 320               			PUSH  R17                                         ;save R17               (  2 clocks) 
 321               			PUSH  R18                                         ;save R18               (  2 clocks) 
 322               			PUSH  R19                                         ;save R19               (  2 clocks) 
 323               			PUSH  R20                                         ;save R20               (  2 clocks) 
 324               			PUSH  R21                                         ;save R21               (  2 clocks) 
 325               			PUSH  R22                                         ;save R22               (  2 clocks) 
 326               			PUSH  R23                                         ;save R23               (  2 clocks) 
 327               			PUSH  R24                                         ;save R24               (  2 clocks) 
 328               			PUSH  R25                                         ;save R25               (  2 clocks) 
 329               			PUSH  R26                                         ;save R26               (  2 clocks) 
 330               			PUSH  R27                                         ;save R27               (  2 clocks) 
 331               			PUSH  R28                                         ;save R28               (  2 clocks) 
 332               			PUSH  R29                                         ;save R29               (  2 clocks) 
 333               			PUSH  R30                                         ;save R30               (  2 clocks) 
 334               			PUSH  R31                                         ;save R31               (  2 clocks) 
 335               			LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 336               			LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 337               			LDS   R18                , KerTID                 ;fetch task id          (  2 clocks) 
 338               			LSL   R18                                         ;left shift to multiply (  1 clock ) 
 339               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 340               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 341               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 342               			IN    R18                , IOSPL                  ;fetch SPL0             (  1 clock ) 
 343               			IN    R19                , IOSPH                  ;fetch SPH0             (  1 clock ) 
 344               			STD   Z+0                , R18                    ;store SPL at ZP+0      (  2 clocks) 
 345               			STD   Z+1                , R19                    ;store SPH at ZP+1      (  2 clocks) 
 346               	.endm                                                                                          
 347               	;;=====================================context save end=====================================;; 
