 212               	;used registers          : R18                                                                 
 213               	;arg registers           : None                                                                
 214               	;return registers        : None                                                                
 215               	;unsafe access registers : R18                                                                 
 216               	.macro  KER_TIMER_RELOAD                                  ;0.75uS @8MHz           (  6 clocks) 
 217               	        LDS   R18                , KerLST                 ;fetch lowst sleep time (  2 clocks) 
 218               			LDI   R19                , 0xFF                   ;set max val            (  1 clock ) 
 219               			SUB   R19                , R18                    ;subtract               (  1 clock ) 
 220               			STS   SRTCNT2            , R19                    ;set val                (  2 clocks) 
 221               	.endm                                                                                          
 222               	;;===================================timer reload end=======================================;; 
