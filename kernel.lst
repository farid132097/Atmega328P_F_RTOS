 148               	;;===============================timer2 async init starting=================================;; 
 149               	;used registers          : R18, R19                                                            
 150               	;arg registers           : None                                                                
 151               	;return registers        : None                                                                
 152               	;unsafe access registers : R18, R19                                                            
 153               	.macro  KER_TIMER2_ASYNC_INIT                             ;~9.13uS @8MHz          (~73 clocks) 
 154               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 155               			STS   SRTCCR2B           , R18                    ;stop timer             (  2 clocks) 
 156               			STS   SRTIMSK2           , R18                    ;clear TIMSK2           (  2 clocks) 
 157               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 158               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 159               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 160               			STS   SROCR2A            , R18                    ;clear compare reg      (  2 clocks) 
 161               			STS   SROCR2B            , R18                    ;clear compare reg      (  2 clocks) 
 162               			STS   SRTCCR2A           , R18                    ;clear controlA reg     (  2 clocks) 
 163               			LDI   R18                , 0x03                   ;prescaler 3            (  1 clock ) 
 164               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 165               			LDI   R18                , KER_RLD                ;clear reg              (  1 clock ) 
 166               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 167               		_KER_TC2_AUB\@:                                                                            
 168               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 169               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 170               			BRNE  _KER_TC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 171               		_KER_TC2_BUB\@:                                                                            
 172               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 173               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 174               			BRNE  _KER_TC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 175               		_KER_OC2_AUB\@:                                                                            
 176               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 177               	        ANDI  R18                , 0x08                   ;check bit OR2AUB       (  1 clock ) 
 178               			BRNE  _KER_OC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 179               		_KER_OC2_BUB\@:                                                                            
 180               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 181               	        ANDI  R18                , 0x04                   ;check bit OCR2BUB      (  1 clock ) 
 182               			BRNE  _KER_OC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 183               		_KER_TC2_UB\@:                                                                             
 184               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 185               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 186               			BRNE  _KER_TC2_UB\@                               ;wait until UB cleared  (  2 clocks) 
 187               		_KER_TC2_TOV2\@:                                                                           
 188               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 189               	        ANDI  R18                , 0x01                   ;check bit TOV2         (  1 clock ) 
 190               	        BREQ  _KER_TC2_OCF2A\@                            ;bit cleared, jump next (  2 clocks) 
 191               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 192               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 193               	    _KER_TC2_OCF2A\@:                                                                          
 194               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 195               	        ANDI  R18                , 0x02                   ;check bit OCF2A        (  1 clock ) 
 196               	        BREQ  _KER_TC2_OCF2B\@                            ;bit cleared, jump next (  2 clocks) 
 197               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 198               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 199               		_KER_TC2_OCF2B\@:                                                                          
 200               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 201               	        ANDI  R18                , 0x04                   ;check bit OCF2B        (  1 clock ) 
 202               	        BREQ  _KER_TC2_INTEN\@                            ;bit cleared, jump next (  2 clocks) 
 203               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 204               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 205               	    _KER_TC2_INTEN\@:                                                                          
 206               			LDI   R18                , 0x01                   ;set TOIE2 bit          (  1 clock ) 
 207               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 208               	.endm                                                                                          
 209               	;;=================================timer2 async init end====================================;; 
