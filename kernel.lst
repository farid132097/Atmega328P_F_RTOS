 981:kernel.S      **** ;used registers          : R18, R19, R20, R22, R24, R25, R26(XL), R27(XH), R30(ZL), R31(ZH)    
 982:kernel.S      **** ;arg registers           : R25:R24(FuncPtr), R22(TaskPriority)                                 
 983:kernel.S      **** ;return registers        : None                                                                
 984:kernel.S      **** ;unsafe access registers : R18, R19, R20, R22, R24, R25, R26(XL), R27(XH), R30(ZL), R31(ZH)    
 985:kernel.S      **** Kernel_Task_Create:                                       ;total 21.50uS @8MHz    (172 clocks) 
 986               	        KER_PUSH_MSP_ZP                                   ;push MSP and ZP        ( 18 clocks) 
 987:kernel.S      **** 		;set priority to KerSchPr+task_id                                                      
 988:kernel.S      **** 		LDI   R30                , lo8(KerSchPr)          ;load low byte          (  1 clock ) 
 989:kernel.S      **** 		LDI   R31                , hi8(KerSchPr)          ;load high byte         (  1 clock ) 
 990               			KER_CALC_ADDR_OFF_BYTES                           ;calc offset            (  5 clocks) 
 991:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 992:kernel.S      **** 		;set task status to KerSchSts+task_id                                                  
 993:kernel.S      **** 		LDI   R30                , lo8(KerSchSts)         ;load low byte          (  1 clock ) 
 994:kernel.S      **** 		LDI   R31                , hi8(KerSchSts)         ;load high byte         (  1 clock ) 
 995:kernel.S      **** 		KER_CALC_ADDR_OFF_BYTES                           ;calc offset            (  5 clocks) 
 996               			LDI   R18                , TASK_READY             ;set status as ready    (  1 clock ) 
 997               			ST    Z                  , R18                    ;save status            (  2 clocks) 
 998               			;stack pointer for current task (KerStack + KER_STK_SZ*(task_id+1) - 1) ->stack top    
 999               			LDS   R18                , KerBase+OFB_TID        ;load task_id           (  2 clocks) 
 1000               			INC   R18                                         ;increment task_id      (  1 clock ) 
 1001               			LDI   R19                , KER_STK_SZ             ;load stack size        (  1 clock ) 
 1002               			MUL   R18                , R19                    ;multiply to get offset (  2 clocks) 
 1003               			MOV   R30                , R0                     ;load multiplied low    (  1 clocks) 
 1004               			MOV   R31                , R1                     ;load multiplied high   (  1 clocks) 
 1005               			SBIW  R30                , 0x01                   ;dec multiplied val-1   (  2 clocks) 
 1006               			CLR   R1                                          ;gcc expects cleared    (  1 clock ) 
 1007               			LDI   R18                , lo8(KerStack)          ;load base addr low     (  1 clock ) 
1008:kernel.S      **** 		LDI   R19                , hi8(KerStack)          ;load base addr high    (  1 clock ) 
1009:kernel.S      **** 		ADD   R30                , R18                    ;add low bytes          (  1 clock ) 
1010:kernel.S      **** 		ADC   R31                , R19                    ;add high bytes+carry   (  1 clock ) 
1011:kernel.S      **** 		OUT   IOSPL              , R30                    ;load SPL               (  1 clock ) 
 1012               	        OUT   IOSPH              , R31                    ;load SPH               (  1 clock ) 
1013:kernel.S      **** 		;function argument directly returns word address                                       
 1014               		    PUSH  R24                                         ;push word addr low     (  2 clocks) 
1015:kernel.S      **** 		PUSH  R25                                         ;push word addr high    (  2 clocks) 
 1016               			;push context to stack of this task                                                    
 1017               			KER_CONTEXT_SAVE_HANDLER                          ;save context           ( 68 clocks) 
 1018               			;read stack pointer of current task (necessary when restore)                           
 1019               			IN    R18                , IOSPL                  ;read SPL               (  1 clock ) 
 1020               	        IN    R19                , IOSPH                  ;read SPH               (  1 clock ) 
 1021               			;calculate the address where current task's SP will be stored and store SP             
 1022               			LDS   R20                , KerBase+OFB_TID        ;load task_id           (  2 clocks) 
 1023               			LSL   R20                                         ;left shift to multiply (  1 clock ) 
 1024               			LDI   R30                , lo8(KerPSP)            ;fetch base pos low     (  1 clock ) 
 1025               			LDI   R31                , hi8(KerPSP)            ;fetch base pos high    (  1 clock ) 
 1026               			ADD   R30                , R20                    ;add offset to array    (  1 clock ) 
 1027               			LDI   R20                , 0x00                   ;clear reg              (  1 clock ) 
1028:kernel.S      **** 		ADC   R31                , R20                    ;add carry if any       (  1 clock ) 
 1029               			ST    Z+                 , R18                    ;SPL at KerPSp+offset   (  2 clocks) 
1030:kernel.S      **** 		ST    Z                  , R19                    ;SPH at KerPSp+offset   (  2 clocks) 
1031:kernel.S      **** 		;increment task_id                                                                     
1032:kernel.S      **** 		LDS   R18                , KerBase+OFB_TID        ;load task_id           (  2 clocks) 
1033:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
1034:kernel.S      **** 		STS   KerBase+OFB_TID    , R18                    ;store task_id          (  2 clocks) 
 1035               			;increment ntask                                                                       
1036:kernel.S      **** 		LDS   R18                , KerBase+OFB_NTSK       ;load ntask             (  2 clocks) 
1037:kernel.S      **** 		INC   R18                                         ;increment ntask        (  1 clock ) 
1038:kernel.S      **** 		STS   KerBase+OFB_NTSK   , R18                    ;store ntask            (  2 clocks) 
 1039               			KER_POP_MSP_ZP                                    ;pop MSP and ZP         ( 18 clocks) 
1040:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
