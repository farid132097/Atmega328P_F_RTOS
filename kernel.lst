 126               	;;===============================timer2 async init starting=================================;; 
 127               	;used registers          : R18, R19                                                            
 128               	;arg registers           : None                                                                
 129               	;return registers        : None                                                                
 130               	;unsafe access registers : R18, R19                                                            
 131               	.macro  KER_TIMER2_ASYNC_INIT                             ;~9.13uS @8MHz          (~73 clocks) 
 132               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 133               			STS   SRTCCR2B           , R18                    ;stop timer             (  2 clocks) 
 134               			STS   SRTIMSK2           , R18                    ;clear TIMSK2           (  2 clocks) 
 135               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 136               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 137               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 138               			STS   SROCR2A            , R18                    ;clear compare reg      (  2 clocks) 
 139               			STS   SROCR2B            , R18                    ;clear compare reg      (  2 clocks) 
 140               			STS   SRTCCR2A           , R18                    ;clear controlA reg     (  2 clocks) 
 141               			LDI   R18                , 0x03                   ;prescaler 3            (  1 clock ) 
 142               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 143               			LDI   R18                , 0x00                   ;clear reg              (  1 clock ) 
 144               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 145               		_KER_TC2_AUB\@:                                                                            
 146               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 147               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 148               			BRNE  _KER_TC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 149               		_KER_TC2_BUB\@:                                                                            
 150               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 151               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 152               			BRNE  _KER_TC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 153               		_KER_OC2_AUB\@:                                                                            
 154               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 155               	        ANDI  R18                , 0x08                   ;check bit OR2AUB       (  1 clock ) 
 156               			BRNE  _KER_OC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 157               		_KER_OC2_BUB\@:                                                                            
 158               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 159               	        ANDI  R18                , 0x04                   ;check bit OCR2BUB      (  1 clock ) 
 160               			BRNE  _KER_OC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 161               		_KER_TC2_UB\@:                                                                             
 162               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 163               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 164               			BRNE  _KER_TC2_UB\@                               ;wait until UB cleared  (  2 clocks) 
 165               		_KER_TC2_TOV2\@:                                                                           
 166               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 167               	        ANDI  R18                , 0x01                   ;check bit TOV2         (  1 clock ) 
 168               	        BREQ  _KER_TC2_OCF2A\@                            ;bit cleared, jump next (  2 clocks) 
 169               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 170               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 171               	    _KER_TC2_OCF2A\@:                                                                          
 172               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 173               	        ANDI  R18                , 0x02                   ;check bit OCF2A        (  1 clock ) 
 174               	        BREQ  _KER_TC2_OCF2B\@                            ;bit cleared, jump next (  2 clocks) 
 175               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 176               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 177               		_KER_TC2_OCF2B\@:                                                                          
 178               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 179               	        ANDI  R18                , 0x04                   ;check bit OCF2B        (  1 clock ) 
 180               	        BREQ  _KER_TC2_INTEN\@                            ;bit cleared, jump next (  2 clocks) 
 181               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 182               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 183               	    _KER_TC2_INTEN\@:                                                                          
 184               			LDI   R18                , 0x01                   ;set TOIE2 bit          (  1 clock ) 
 185               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 186               	.endm                                                                                          
 187               	;;=================================timer2 async init end====================================;; 
