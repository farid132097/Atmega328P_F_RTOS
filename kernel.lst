 435               	.macro  KER_RUN_SCHEDULER                                 ;total 0.25uS @8MHz     (  2 clocks) 
 436               			LDS   R18                , KerTID                 ;load val               (  2 clocks) 
 437               			LDS   R19                , KerNTSK                ;load ntask             (  2 clocks) 
 438               			LDI   R20                , 0x01                   ;set val                (  1 clock ) 
 439               			ADD   R18                , R20                    ;increment val          (  1 clock ) 
 440               			CP    R18                , R19                    ;compare val            (  1 clock ) 
 441               			BRLO  KER_SCH_ASSN\@                                                                   
 442               			LDI   R18                , 0x00                   ;roll back              (  1 clock ) 
 443               		KER_SCH_ASSN\@:                                                                            
 444               		    STS   KerTID             , R18                    ;save val               (  2 clocks) 
 445               	.endm                                                                                          
