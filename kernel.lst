1068:kernel.S      **** ;used registers          : R1, R18, R19, R22, R24, R25, R26(XL), R27(XH), R30(ZL), R31(ZH)     
 1069               	;arg registers           : None                                                                
 1070               	;return registers        : None                                                                
 1071               	;unsafe access registers : R1, R18, R19, R22, R24, R25, R26(XL), R27(XH), R30(ZL), R31(ZH)     
 1072               	Kernel_Init:                                              ;total 39.75uS @8MHz    (318 clocks) 
 1073               			CLR   R1                                          ;gcc expects            (  1 clock ) 
 1074               	        ;store stack top (for MSP) addr to KerSSZ+OFM_MSPI0:1                                  
 1075               			LDI   R18                , lo8(KerSSZ+OFM_MSPS)   ;load low address       (  1 clock ) 
 1076               			LDI   R19                , hi8(KerSSZ+OFM_MSPS)   ;load high address      (  1 clock ) 
 1077               	        STS   KerSSZ+OFM_MSPI+0  , R18                    ;set mspi to stack top  (  2 clocks) 
 1078               			STS   KerSSZ+OFM_MSPI+1  , R19                    ;set mspi to stack top  (  2 clocks) 
 1079               			KER_PUSH_MSP_ZP                                   ;push MSP and ZP        ( 18 clocks) 
 1080               			;init timer for kernel                                                                 
 1081               			LDI   R24                , 0x04                   ;set prescaler          (  1 clock ) 
1082:kernel.S      **** 		LDI   R22                , 0x7D                   ;set reload val         (  1 clock ) 
1083:kernel.S      **** 		CALL  Kernel_Tick_Init                            ;init timer             ( 92 clocks) 
 1084               			;create idle task at task_id 0, priority 0xFF (lowest)                                 
1085:kernel.S      **** 		LDI   R24                , lo8(Kernel_Task_Idle)  ;load func addr low     (  1 clock ) 
1086:kernel.S      **** 		LDI   R25                , hi8(Kernel_Task_Idle)  ;load func addr high    (  1 clock ) 
1087:kernel.S      **** 		LSR   R25                                         ;right shift to divide  (  1 clock ) 
1088:kernel.S      **** 		ROR   R24                                         ;rotate right th carry  (  1 clock ) 
1089:kernel.S      **** 		LDI   R22                , 0xFF                   ;set max val            (  1 clock ) 
 1090               			CALL  Kernel_Task_Create                          ;init idle task         (172 clocks) 
1091:kernel.S      **** 		KER_POP_MSP_ZP                                    ;pop MSP and ZP         ( 18 clocks) 
1092:kernel.S      **** 		;execute return to jump to task0, pushed while task init                               
1093:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
1094:kernel.S      **** ;;======================================kernel init end=====================================;; 
