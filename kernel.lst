 394               	;;===================================msp zp save starting===================================;; 
 395               	;used registers          : R18, R19, R30, R31                                                  
 396               	;arg registers           : None                                                                
 397               	;return registers        : None                                                                
 398               	;unsafe access registers : None                                                                
 399               	.macro  KER_MSP_ZP_SAVE                                   ;total 1.25uS @8MHz     ( 10 clocks) 
 400               	        IN    R18                , IOSPL                  ;load SPL               (  1 clock ) 
 401               			IN    R19                , IOSPH                  ;load SPH               (  1 clock ) 
 402               			STS   KerMSPZP+0         , R18                    ;store SPL              (  2 clocks) 
 403               			STS   KerMSPZP+1         , R19                    ;store SPH              (  2 clocks) 
 404               			STS   KerMSPZP+2         , R30                    ;store ZL               (  2 clocks) 
 405               			STS   KerMSPZP+3         , R31                    ;store ZH               (  2 clocks) 
 406               	.endm                                                                                          
