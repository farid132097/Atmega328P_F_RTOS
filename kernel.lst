 218               	.macro  KER_TIMER2_TCNT2_UB                               ;~9.13uS @8MHz          (~73 clocks) 
 219               		_KER_TMR2_UB\@:                                                                            
 220               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 221               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 222               			BRNE  _KER_TMR2_UB\@                              ;wait until UB cleared  (  2 clocks) 
 223               	.endm                                                                                          
 224               	;;==============================timer2 tcnt update busy end==================================;; 
