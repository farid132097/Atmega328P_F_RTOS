 532               	;;=========================calculate offset addr in words starting==========================;; 
 533               	;used registers          : R18, R30(ZL), R31(ZH)                                               
 534               	;arg registers           : R30(ZL), R31(ZH)                                                    
 535               	;return registers        : R30(ZL), R31(ZH)                                                    
 536               	;unsafe access registers : R18, R30(ZL), R31(ZH)                                               
 537               	.macro  KER_CALC_ADDR_OFF_WORD                            ;total 0.75uS @8MHz     (  6 clocks) 
 538               	        LDS   R18                , KerBase+OFB_TID        ;fetch task_id          (  2 clocks) 
 539               			LSL   R18                                         ;left shift to multiply (  1 clock ) 
 540               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 541               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 542               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 543               	.endm                                                                                          
 544               	;;=============================calculate offset addr in words end===========================;; 
