  17               	;;============================define user address or macro starting=========================;; 
  18               	.equ     KER_RLD,         0x00                            ;KER_RLD=0xFF-(F_CPU/KER_PRS/KER_TR) 
  19               	.equ     KER_STK_SZ,      128                             ;stack size in bytes for each task   
  20               	.equ     KER_MX_NTSK,     KER_MAX_TASK+1                  ;max number of tasks                 
  21               	;;==============================define user address or macro end============================;; 
  22               	
  23               	
  24               	;;===============================define data offsets starting===============================;; 
  25               	.equ     OFT_STS  ,       0x00                            ;offset from KerTCB task status      
  26               	.equ     OFT_SLP  ,       0x01                            ;offset from KerTCB sleep duration   
  27               	.equ     OFT_PRIO ,       0x02                            ;offset from KerTCB task priority    
  28               	.equ     OFT_PSP  ,       0x03                            ;offset from KerTCB task PSP         
  29               	.equ     OFB_CTSK ,       0x00                            ;offset from KerBase curr task       
  30               	.equ     OFB_NTSK ,       0x01                            ;offset from KerBase next task       
  31               	.equ     OFB_TTSK ,       0x02                            ;offset from KerBase total tasks     
  32               	;;==================================define data offsets end=================================;; 
  33               	
  34               	
  35               	
  36               	;;===========================define hardware reg address starting===========================;; 
  37               	;SRAM Mapped Addresses, LDS/STS can be used                                                    
  38               	.equ     SRASSR  ,        0xB6                            ;manually defined ASSR in SRAM       
  39               	.equ     SROCR2B ,        0xB4                            ;manually defined OCR2B in SRAM      
  40               	.equ     SROCR2A ,        0xB3                            ;manually defined OCR2A in SRAM      
  41               	.equ     SRTCNT2 ,        0xB2                            ;manually defined TNCT2 in SRAM      
  42               	.equ     SRTCCR2B,        0xB1                            ;manually defined TCCR2B in SRAM     
  43               	.equ     SRTCCR2A,        0xB0                            ;manually defined TCCR2A in SRAM     
  44               	.equ     SRADMUX ,        0x7C                            ;manually defined ADMUX in SRAM      
  45               	.equ     SRADCSRA,        0x7A                            ;manually defined ADCSRA in SRAM     
  46               	.equ     SRTIMSK2,        0x70                            ;manually defined TIMSK2 in SRAM     
  47               	.equ     SRCLKPR ,        0x61                            ;manually defined CLKPR in SRAM      
  48               	.equ     SRWDTCSR,        0x60                            ;manually defined WDTCSR in SRAM     
