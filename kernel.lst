 128               	;;===============================timer2 async init starting=================================;; 
 129               	;used registers          : R18, R19                                                            
 130               	;arg registers           : None                                                                
 131               	;return registers        : None                                                                
 132               	;unsafe access registers : R18, R19                                                            
 133               	.macro  KER_TIMER2_ASYNC_INIT                             ;~9.13uS @8MHz          (~73 clocks) 
 134               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 135               			STS   SRTCCR2B           , R18                    ;stop timer             (  2 clocks) 
 136               			STS   SRTIMSK2           , R18                    ;clear TIMSK2           (  2 clocks) 
 137               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 138               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 139               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 140               			STS   SROCR2A            , R18                    ;clear compare reg      (  2 clocks) 
 141               			STS   SROCR2B            , R18                    ;clear compare reg      (  2 clocks) 
 142               			STS   SRTCCR2A           , R18                    ;clear controlA reg     (  2 clocks) 
 143               			LDI   R18                , 0x03                   ;prescaler 3            (  1 clock ) 
 144               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 145               			LDI   R18                , 0x00                   ;clear reg              (  1 clock ) 
 146               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 147               		_KER_TC2_AUB\@:                                                                            
 148               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 149               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 150               			BRNE  _KER_TC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 151               		_KER_TC2_BUB\@:                                                                            
 152               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 153               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 154               			BRNE  _KER_TC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 155               		_KER_OC2_AUB\@:                                                                            
 156               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 157               	        ANDI  R18                , 0x08                   ;check bit OR2AUB       (  1 clock ) 
 158               			BRNE  _KER_OC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 159               		_KER_OC2_BUB\@:                                                                            
 160               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 161               	        ANDI  R18                , 0x04                   ;check bit OCR2BUB      (  1 clock ) 
 162               			BRNE  _KER_OC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 163               		_KER_TC2_UB\@:                                                                             
 164               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 165               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 166               			BRNE  _KER_TC2_UB\@                               ;wait until UB cleared  (  2 clocks) 
 167               		_KER_TC2_TOV2\@:                                                                           
 168               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 169               	        ANDI  R18                , 0x01                   ;check bit TOV2         (  1 clock ) 
 170               	        BREQ  _KER_TC2_OCF2A\@                            ;bit cleared, jump next (  2 clocks) 
 171               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 172               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 173               	    _KER_TC2_OCF2A\@:                                                                          
 174               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 175               	        ANDI  R18                , 0x02                   ;check bit OCF2A        (  1 clock ) 
 176               	        BREQ  _KER_TC2_OCF2B\@                            ;bit cleared, jump next (  2 clocks) 
 177               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 178               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 179               		_KER_TC2_OCF2B\@:                                                                          
 180               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 181               	        ANDI  R18                , 0x04                   ;check bit OCF2B        (  1 clock ) 
 182               	        BREQ  _KER_TC2_INTEN\@                            ;bit cleared, jump next (  2 clocks) 
 183               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 184               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 185               	    _KER_TC2_INTEN\@:                                                                          
 186               			LDI   R18                , 0x01                   ;set TOIE2 bit          (  1 clock ) 
 187               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 188               	.endm                                                                                          
 189               	;;=================================timer2 async init end====================================;; 
