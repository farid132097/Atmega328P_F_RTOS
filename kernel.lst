 167               	.macro  KER_TIMER_INIT                                    ;~9.13uS @8MHz          (~73 clocks) 
 168               			KER_INTERRUPT_STATE_SAVE                          ;save interrupt state   (  3 clocks) 
 169               	        CLI                                               ;disable interrupts     (  1 clock ) 
 170               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 171               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 172               			STS   SRTCCR2A           , R18                    ;set val to TCCR2A      (  2 clocks) 
 173               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 174               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 175               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 176               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 177               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 178               			LDI   R18                , 0x03                   ;prescaler 32           (  1 clock ) 
 179               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 180               		_KER_TCR2AUB\@:                                                                            
 181               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 182               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 183               			BRNE  _KER_TCR2AUB\@                              ;wait until AUB cleared (  2 clocks) 
 184               		_KER_TCR2BUB\@:                                                                            
 185               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 186               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 187               			BRNE  _KER_TCR2BUB\@                              ;wait until BUB cleared (  2 clocks) 
 188               		_KER_TCN2UB\@:                                                                             
 189               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 190               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 191               			BRNE  _KER_TCN2UB\@                               ;wait until UB cleared  (  2 clocks) 
 192               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 193               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 194               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 195               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 196               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 197               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 198               			KER_INTERRUPT_STATE_RESTORE                       ;restore interrupt      (  5 clocks) 
 199               	.endm                                                                                          
