 364               	.macro  KER_MSP_ZP_SAVE                                   ;total 1.25uS @8MHz     ( 10 clocks) 
 365               	        IN    R18                , IOSPL                  ;load SPL               (  1 clock ) 
 366               			IN    R19                , IOSPH                  ;load SPH               (  1 clock ) 
 367               			STS   KerMSPZP+0         , R18                    ;store SPL              (  2 clocks) 
 368               			STS   KerMSPZP+1         , R19                    ;store SPH              (  2 clocks) 
 369               			STS   KerMSPZP+2         , R30                    ;store ZL               (  2 clocks) 
 370               			STS   KerMSPZP+3         , R31                    ;store ZH               (  2 clocks) 
 371               	.endm                                                                                          
