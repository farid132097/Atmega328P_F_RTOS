 455               	.macro KER_ENTER_SLEEP                                    ;total 0.75uS @8MHz     (  6 clocks) 
 456               	    #ifdef KER_IDLE_AS_SLEEP                                                                   
 457               			LDS   R18                , SRSMCR                 ;load SMCR              (  2 clocks) 
 458               			ORI   R18                , 0x01                   ;set SE bit             (  1 clock ) 
 459               			STS   SRSMCR             , R18                    ;set val                (  2 clocks) 
 460               			SLEEP                                             ;sleep cpu              (  1 clock ) 
 461               		#endif                                                                                     
 462               	.endm                                                                                          
