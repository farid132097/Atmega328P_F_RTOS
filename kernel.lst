 1107               	    _IDLE_LOOP:                                           ;forever loop                        
 1108               		    KER_DISABLE_ANALOG_DOMAIN                         ;disable adc, ac        ( 10 clocks) 
 1109               			#ifdef KER_CALL_FUNC_BEFORE_SLEEP                                                      
