 359               	.macro  KER_MSP_ZP_SAVE                                   ;total 1.25uS @8MHz     ( 10 clocks) 
 360               	        IN    R18                , IOSPL                  ;load SPL               (  1 clock ) 
 361               			IN    R19                , IOSPH                  ;load SPH               (  1 clock ) 
 362               			STS   KerMSPZP+0         , R18                    ;store SPL              (  2 clocks) 
 363               			STS   KerMSPZP+1         , R19                    ;store SPH              (  2 clocks) 
 364               			STS   KerMSPZP+2         , R30                    ;store ZL               (  2 clocks) 
 365               			STS   KerMSPZP+3         , R31                    ;store ZH               (  2 clocks) 
 366               	.endm                                                                                          
 367               	
 368               	
 369               	
 370               	
 371               	
 372               	
 373               	.macro  KER_MSP_ZP_RESTORE                                ;total 1.25uS @8MHz     ( 10 clocks) 
 374               			LDS   R31                , KerMSPZP+3             ;fetch ZH               (  2 clocks) 
 375               			LDS   R30                , KerMSPZP+2             ;fetch ZL               (  2 clocks) 
 376               			LDS   R19                , KerMSPZP+1             ;fetch SPH              (  2 clocks) 
 377               			LDS   R18                , KerMSPZP+0             ;fetch SPL              (  2 clocks) 
 378               			OUT   IOSPL              , R18                    ;load SPL               (  1 clock ) 
 379               			OUT   IOSPH              , R19                    ;load SPH               (  1 clock ) 
 380               	.endm                                                                                          
