 337               	.macro  KER_SAVE_R0_CLI_SREG                              ;total 0.75uS @8MHz     (  6 clocks) 
 338               	        PUSH  R0                                          ;push R0                (  2 clocks) 
 339               			IN    R0                 , IOSREG                 ;save SREG              (  1 clock ) 
