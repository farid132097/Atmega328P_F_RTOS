 213               	.macro  KER_TIMER_INIT                                    ;~9.13uS max @8MHz      (~73 clocks) 
 214               	        KER_TIMER2_DISABLE                                ;1.75uS @8MHz           ( 14 clocks) 
 215               			KER_TIMER2_ASYNC_INIT                             ;total 1.5uS @8MHz      (~73 clocks) 
