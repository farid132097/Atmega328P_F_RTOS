 436               	.macro  KER_MSP_ZP_RESTORE                                ;total 1.25uS @8MHz     ( 10 clocks) 
 437               			LDS   R31                , KerMSPZP+3             ;fetch ZH               (  2 clocks) 
 438               			LDS   R30                , KerMSPZP+2             ;fetch ZL               (  2 clocks) 
 439               			LDS   R19                , KerMSPZP+1             ;fetch SPH              (  2 clocks) 
 440               			LDS   R18                , KerMSPZP+0             ;fetch SPL              (  2 clocks) 
 441               			OUT   IOSPL              , R18                    ;load SPL               (  1 clock ) 
 442               			OUT   IOSPH              , R19                    ;load SPH               (  1 clock ) 
 443               	.endm                                                                                          
