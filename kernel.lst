 443               	.macro KER_SLEEP_INIT                                     ;total 0.63uS @8MHz     (  5 clocks) 
 444               	    #ifdef KER_IDLE_AS_SLEEP                                                                   
 445               			LDI   R18                , 0x06                   ;set SM[2:0] val        (  1 clock ) 
 446               			STS   SRSMCR             , R18                    ;set sleep control val  (  2 clocks) 
 447               		#endif                                                                                     
