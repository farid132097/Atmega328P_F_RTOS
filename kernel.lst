 411               	.macro  KER_FIND_LST                                      ;total 0.25uS @8MHz     (  2 clocks) 
 412               			LDS   R18                , KerNTSK                ;load ntask             (  2 clocks) 
 413               			LDI   R19                , 0x00                   ;loop counter           (  1 clock ) 
 414               			LDI   R20                , 0x00                   ;initial LST TID        (  1 clock ) 
 415               			LDI   R21                , 0xFF                   ;initial LST            (  1 clock ) 
 416               			LDI   R30                , lo8(KerSleep)          ;fetch base pos low     (  1 clock ) 
 417               			LDI   R31                , hi8(KerSleep)          ;fetch base pos high    (  1 clock ) 
 418               	    KER_LST_LOOP\@:																			   
 419               			LDD   R22                , Z+                     ;load sleep val         (  2 clocks) 
 420               			CP    R22                , R21                    ;compare                (  1 clock ) 
 421               			BRSH  KER_LST_LP_CMPRE\@                          ;jmp to label           (  2 clocks) 
 422               			MOV   R20                , R19                    ;new LST TID            (  1 clock ) 
 423               			MOV   R21                , R22                    ;new LST                (  1 clock ) 
 424               		KER_LST_LP_CMPRE\@:																		   
 425               			INC   R19                                         ;increment              (  1 clock ) 
 426               			CP    R19                , R18                    ;compare                (  1 clock ) 
 427               			BRLO  KER_LST_LOOP\@                              ;jmp to label           (  2 clocks) 
 428               	.endm                                                                                          
