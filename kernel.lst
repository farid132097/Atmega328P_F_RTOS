 441               	.macro KER_ENTER_SLEEP                                    ;total 0.75uS @8MHz     (  6 clocks) 
 442               	    #ifdef KER_IDLE_AS_SLEEP                                                                   
 443               			LDS   R18                , SRSMCR                 ;load SMCR              (  2 clocks) 
 444               			ORI   R18                , 0x01                   ;set SE bit             (  1 clock ) 
 445               			STS   SRSMCR             , R18                    ;set val                (  2 clocks) 
 446               			SLEEP                                             ;sleep cpu              (  1 clock ) 
 447               		#endif                                                                                     
 448               	.endm                                                                                          
