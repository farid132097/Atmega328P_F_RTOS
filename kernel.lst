 231               	;return registers        : None                                                                
 232               	;unsafe access registers : R18, R19                                                            
 233               	.macro  KER_TIMER_INIT                                    ;~9.13uS max @8MHz      (~73 clocks) 
 234               	        KER_TIMER2_DISABLE                                ;1.75uS @8MHz           ( 14 clocks) 
 235               			KER_TIMER2_ASYNC_INIT                             ;total 1.5uS @8MHz      (~73 clocks) 
 236               	.endm                                                                                          
 237               	;;======================================timer init end======================================;; 
