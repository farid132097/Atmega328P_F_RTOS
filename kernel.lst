 169               	.macro  KER_TIMER_INIT                                    ;~9.13uS @8MHz          (~73 clocks) 
 170               			KER_INTERRUPT_STATE_SAVE                          ;save interrupt state   (  3 clocks) 
 171               	        CLI                                               ;disable interrupts     (  1 clock ) 
 172               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 173               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 174               			STS   SRTCCR2A           , R18                    ;set val to TCCR2A      (  2 clocks) 
 175               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 176               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 177               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 178               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 179               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 180               			LDI   R18                , 0x03                   ;prescaler 32           (  1 clock ) 
 181               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 182               		KER_TCR2AUB\@:                                                                             
 183               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 184               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 185               			BRNE  KER_TCR2AUB\@                               ;wait until AUB cleared (  2 clocks) 
 186               		KER_TCR2BUB\@:                                                                             
 187               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 188               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 189               			BRNE  KER_TCR2BUB\@                               ;wait until BUB cleared (  2 clocks) 
 190               		KER_TCN2UB\@:                                                                              
 191               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 192               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 193               			BRNE  KER_TCN2UB\@                                ;wait until UB cleared  (  2 clocks) 
 194               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 195               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 196               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 197               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 198               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 199               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 200               			KER_INTERRUPT_STATE_RESTORE                       ;restore interrupt      (  5 clocks) 
 201               	.endm                                                                                          
