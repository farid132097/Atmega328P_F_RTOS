 545               	Kernel_Task_Create:                                       ;total 21.50uS @8MHz    (172 clocks) 
 546:kernel.S      **** 		KER_MSP_ZP_SAVE                                   ;push MSP and ZP        ( 18 clocks) 
 547               			;set priority to KerPrio+task_id                                                       
 548:kernel.S      **** 		LDI   R30                , lo8(KerPrio)           ;load low byte          (  1 clock ) 
 549:kernel.S      **** 		LDI   R31                , hi8(KerPrio)           ;load high byte         (  1 clock ) 
 550:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 551:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 552:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 553:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 554:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 555               	
 556               			;set task status to KerSleep+task_id                                                  
 557:kernel.S      **** 		LDI   R30                , lo8(KerSleep)          ;load low byte          (  1 clock ) 
 558:kernel.S      **** 		LDI   R31                , hi8(KerSleep)          ;load high byte         (  1 clock ) 
 559:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 560:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 561:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 562:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 563:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 564:kernel.S      **** 		LDI   R18                , 0x00                   ;set sleep time->ready  (  1 clock ) 
 565:kernel.S      **** 		ST    Z                  , R18                    ;save status            (  2 clocks) 
 566               	
 567               			;stack pointer for current task (KerStack + KER_STK_SZ*(task_id+1) - 1) ->stack top    
 568:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 569:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 570:kernel.S      **** 		LDI   R19                , KER_STK_SZ             ;load stack size        (  1 clock ) 
 571:kernel.S      **** 		MUL   R18                , R19                    ;multiply to get offset (  2 clocks) 
 572:kernel.S      **** 		MOV   R30                , R0                     ;load multiplied low    (  1 clocks) 
 573:kernel.S      **** 		MOV   R31                , R1                     ;load multiplied high   (  1 clocks) 
 574:kernel.S      **** 		SBIW  R30                , 0x01                   ;dec multiplied val-1   (  2 clocks) 
 575:kernel.S      **** 		CLR   R1                                          ;gcc expects cleared    (  1 clock ) 
 576:kernel.S      **** 		LDI   R18                , lo8(KerStack)          ;load base addr low     (  1 clock ) 
 577:kernel.S      **** 		LDI   R19                , hi8(KerStack)          ;load base addr high    (  1 clock ) 
 578:kernel.S      **** 		ADD   R30                , R18                    ;add low bytes          (  1 clock ) 
 579:kernel.S      **** 		ADC   R31                , R19                    ;add high bytes+carry   (  1 clock ) 
 580:kernel.S      **** 		OUT   IOSPL              , R30                    ;load SPL               (  1 clock ) 
 581:kernel.S      ****         OUT   IOSPH              , R31                    ;load SPH               (  1 clock ) 
 582               			;function argument directly returns word address                                       
 583:kernel.S      **** 	    PUSH  R24                                         ;push word addr low     (  2 clocks) 
 584:kernel.S      **** 		PUSH  R25                                         ;push word addr high    (  2 clocks) 
 585               			;push context to stack of this task                                                    
 586:kernel.S      **** 		SEI                                               ;enable interrupt       (  1 clock ) 
 587:kernel.S      **** 		KER_CONTEXT_SAVE                                  ;save context           ( 68 clocks) 
 588               			;read stack pointer of current task (necessary when restore)                           
 589:kernel.S      **** 		IN    R18                , IOSPL                  ;read SPL               (  1 clock ) 
 590:kernel.S      ****         IN    R19                , IOSPH                  ;read SPH               (  1 clock ) 
 591               			;calculate the address where current task's SP will be stored and store SP             
 592:kernel.S      **** 		LDS   R20                , KerTID                 ;load task_id           (  2 clocks) 
 593:kernel.S      **** 		LSL   R20                                         ;left shift to multiply (  1 clock ) 
 594:kernel.S      **** 		LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 595:kernel.S      **** 		LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 596:kernel.S      **** 		ADD   R30                , R20                    ;add offset to array    (  1 clock ) 
 597:kernel.S      **** 		LDI   R20                , 0x00                   ;clear reg              (  1 clock ) 
 598:kernel.S      **** 		ADC   R31                , R20                    ;add carry if any       (  1 clock ) 
 599:kernel.S      **** 		ST    Z+                 , R18                    ;SPL at KerTSP+offset   (  2 clocks) 
 600:kernel.S      **** 		ST    Z                  , R19                    ;SPH at KerTSP+offset   (  2 clocks) 
 601               			;increment task_id                                                                     
 602:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 603:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 604:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 605               			;increment ntask                                                                       
 606:kernel.S      **** 		LDS   R18                , KerNTSK                ;load ntask             (  2 clocks) 
 607:kernel.S      **** 		INC   R18                                         ;increment ntask        (  1 clock ) 
 608:kernel.S      **** 		STS   KerNTSK   , R18                             ;store ntask            (  2 clocks) 
 609:kernel.S      **** 		KER_MSP_ZP_RESTORE                                ;pop MSP and ZP         ( 18 clocks) 
 610:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
