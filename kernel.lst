 278               	;;=================================restore r0~r31 starting==================================;; 
 279               	;used registers          : R0~R31                                                              
 280               	;arg registers           : None                                                                
 281               	;return registers        : None                                                                
 282               	;unsafe access registers : None                                                                
 283               	.macro  KER_RESTORE_R0_R31                                ;total 8.38uS @8MHz     ( 62 clocks) 
 284               			POP   R31                                         ;restore R31            (  2 clocks) 
 285               			POP   R30                                         ;restore R30            (  2 clocks) 
 286               			POP   R29                                         ;restore R29            (  2 clocks) 
 287               			POP   R28                                         ;restore R28            (  2 clocks) 
 288               			POP   R27                                         ;restore R27            (  2 clocks) 
 289               			POP   R26                                         ;restore R26            (  2 clocks) 
 290               			POP   R25                                         ;restore R25            (  2 clocks) 
 291               			POP   R24                                         ;restore R24            (  2 clocks) 
 292               			POP   R23                                         ;restore R23            (  2 clocks) 
 293               			POP   R22                                         ;restore R22            (  2 clocks) 
 294               			POP   R21                                         ;restore R21            (  2 clocks) 
 295               			POP   R20                                         ;restore R20            (  2 clocks) 
 296               			POP   R19                                         ;restore R19            (  2 clocks) 
 297               			POP   R18                                         ;restore R18            (  2 clocks) 
 298               			POP   R17                                         ;restore R17            (  2 clocks) 
 299               			POP   R16                                         ;restore R16            (  2 clocks) 
 300               			POP   R15                                         ;restore R15            (  2 clocks) 
 301               			POP   R14                                         ;restore R14            (  2 clocks) 
 302               			POP   R13                                         ;restore R13            (  2 clocks) 
 303               			POP   R12                                         ;restore R12            (  2 clocks) 
 304               			POP   R11                                         ;restore R11            (  2 clocks) 
 305               			POP   R10                                         ;restore R10            (  2 clocks) 
 306               			POP   R9                                          ;restore R9             (  2 clocks) 
 307               			POP   R8                                          ;restore R8             (  2 clocks) 
 308               			POP   R7                                          ;restore R7             (  2 clocks) 
 309               			POP   R6                                          ;restore R6             (  2 clocks) 
 310               			POP   R5                                          ;restore R5             (  2 clocks) 
 311               			POP   R4                                          ;restore R4             (  2 clocks) 
 312               			POP   R3                                          ;restore R3             (  2 clocks) 
 313               			POP   R2                                          ;restore R2             (  2 clocks) 
 314               			POP   R1                                          ;restore R1             (  2 clocks) 
 315               			POP   R0                                          ;fetch SREG             (  2 clocks) 
 316               			OUT   IOSREG             , R0                     ;load SREG              (  1 clock ) 
 317               			POP   R0                                          ;restore R0             (  2 clocks) 
 318               			SEI                                               ;enable interrupt       (  1 clock ) 
 319               	.endm                                                                                          
