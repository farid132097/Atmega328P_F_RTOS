 623               	Kernel_Start_Tasks:                                       ;total 25.63uS @8MHz    (205 clocks) 
 624:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 625:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 626:kernel.S      **** 		KER_LOAD_TASK_ID_AND_SP                           ;load next task id, SP  ( 14 clocks) 
 627:kernel.S      **** 		KER_CONTEXT_RESTORE                               ;restore context        ( 68 clocks) 
 628:kernel.S      **** 		CALL  Kernel_Timer_Init                           ;timer init             (--- clocks) 
 629:kernel.S      **** 		SEI
 630:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
