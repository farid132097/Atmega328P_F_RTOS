 662:kernel.S      **** 		STS   KerLST             , R24                    ;store val              (  2 clocks) 
 663:kernel.S      **** 		KER_TIMER_RELOAD_MS                               ;reload val             (--- clocks) 
 664:kernel.S      **** 		KER_ENTER_SLEEP
