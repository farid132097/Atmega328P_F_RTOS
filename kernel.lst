 157               	
 158               	.macro  KER_INTERRUPT_STATE_RESTORE                       ;total 0.625uS @8MHz    (  5 clocks) 
 159               	        LDS   R18                , KerINTST               ;load interrupt state   (  2 clocks) 
 160               			SBRC  R18                , 0x07                   ;check bit7 (I bit)     (  2 clocks) 
 161               			SEI                                               ;enable interrupt       (  1 clock ) 
 162               	.endm                                                                                          
