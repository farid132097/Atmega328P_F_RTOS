 305               	
 306               	.macro  KER_CONTEXT_RESTORE                               ;total 8.38uS @8MHz     ( 81 clocks) 
 307               	        LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 308               			LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 309               			LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 310               			LSL   R18                                         ;left shift to multiply (  1 clock ) 
 311               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 312               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 313               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 314               			LDD   R18                , Z+0                    ;load SPL at ZP         (  2 clocks) 
 315               			LDD   R19                , Z+1                    ;load SPH at ZP         (  2 clocks) 
 316               			OUT   IOSPL              , R18                    ;load SPL0              (  1 clock ) 
 317               			OUT   IOSPH              , R19                    ;load SPH0              (  1 clock ) 
 318               			POP   R31                                         ;restore R31            (  2 clocks) 
 319               			POP   R30                                         ;restore R30            (  2 clocks) 
 320               			POP   R29                                         ;restore R29            (  2 clocks) 
 321               			POP   R28                                         ;restore R28            (  2 clocks) 
 322               			POP   R27                                         ;restore R27            (  2 clocks) 
 323               			POP   R26                                         ;restore R26            (  2 clocks) 
 324               			POP   R25                                         ;restore R25            (  2 clocks) 
 325               			POP   R24                                         ;restore R24            (  2 clocks) 
 326               			POP   R23                                         ;restore R23            (  2 clocks) 
 327               			POP   R22                                         ;restore R22            (  2 clocks) 
 328               			POP   R21                                         ;restore R21            (  2 clocks) 
 329               			POP   R20                                         ;restore R20            (  2 clocks) 
 330               			POP   R19                                         ;restore R19            (  2 clocks) 
 331               			POP   R18                                         ;restore R18            (  2 clocks) 
 332               			POP   R17                                         ;restore R17            (  2 clocks) 
 333               			POP   R16                                         ;restore R16            (  2 clocks) 
 334               			POP   R15                                         ;restore R15            (  2 clocks) 
 335               			POP   R14                                         ;restore R14            (  2 clocks) 
 336               			POP   R13                                         ;restore R13            (  2 clocks) 
 337               			POP   R12                                         ;restore R12            (  2 clocks) 
 338               			POP   R11                                         ;restore R11            (  2 clocks) 
 339               			POP   R10                                         ;restore R10            (  2 clocks) 
 340               			POP   R9                                          ;restore R9             (  2 clocks) 
 341               			POP   R8                                          ;restore R8             (  2 clocks) 
 342               			POP   R7                                          ;restore R7             (  2 clocks) 
 343               			POP   R6                                          ;restore R6             (  2 clocks) 
 344               			POP   R5                                          ;restore R5             (  2 clocks) 
 345               			POP   R4                                          ;restore R4             (  2 clocks) 
 346               			POP   R3                                          ;restore R3             (  2 clocks) 
 347               			POP   R2                                          ;restore R2             (  2 clocks) 
 348               			POP   R1                                          ;restore R1             (  2 clocks) 
 349               			POP   R0                                          ;fetch SREG             (  2 clocks) 
 350               			OUT   IOSREG             , R0                     ;load SREG              (  1 clock ) 
 351               			POP   R0                                          ;restore R0             (  2 clocks) 
 352               	.endm                                                                                          
