 207               	.macro  KER_TIMER_RELOAD_MS                               ;0.75uS @8MHz           (  6 clocks) 
 208               	        LDS   R18                , KerLST                 ;fetch lowst sleep time (  2 clocks) 
 209               			CPI   R18                , 0x15                   ;compare with 21        (  1 clock ) 
 210               			BRCS  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 211               			CPI   R18                , 0x3F                   ;compare with 63        (  1 clock ) 
 212               			BRCC  KER_TIMER_RLD_CMP105\@                      ;jmp to label           (  2 clocks) 
 213               			SUBI  R18                , 0xFF                   ;add 1                  (  1 clock ) 
 214               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 215               		KER_TIMER_RLD_CMP105\@:                                                                    
 216               			CPI   R18                , 0x69                   ;compare with 105       (  1 clock ) 
 217               			BRCC  KER_TIMER_RLD_CMP146\@                      ;jmp to label           (  2 clocks) 
 218               			SUBI  R18                , 0xFE                   ;add 2                  (  1 clock ) 
 219               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 220               		KER_TIMER_RLD_CMP146\@:                                                                    
 221               			CPI   R18                , 0x92                   ;compare with 146       (  1 clock ) 
 222               			BRCC  KER_TIMER_RLD_CMP188\@                      ;jmp to label           (  2 clocks) 
 223               			SUBI  R18                , 0xFD                   ;add 3                  (  1 clock ) 
 224               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 225               		KER_TIMER_RLD_CMP188\@:                                                                    
 226               			CPI   R18                , 0xBC                   ;compare with 188       (  1 clock ) 
 227               			BRCC  KER_TIMER_RLD_CMP230\@                      ;jmp to label           (  2 clocks) 
 228               			SUBI  R18                , 0xFC                   ;add 4                  (  1 clock ) 
 229               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 230               		KER_TIMER_RLD_CMP230\@:                                                                    
 231               			CPI   R18                , 0xE6                   ;compare with 230       (  1 clock ) 
 232               			BRCC  KER_TIMER_RLD_ELSE\@                        ;jmp to label           (  2 clocks) 
 233               			SUBI  R18                , 0xFB                   ;add 5                  (  1 clock ) 
 234               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 235               		KER_TIMER_RLD_ELSE\@:                                                                      
 236               			SUBI  R18                , 0xFA                   ;add 6                  (  1 clock ) 
 237               			RJMP  KER_TIMER_LOAD_TCNT2\@                      ;jmp to label           (  2 clocks) 
 238               		KER_TIMER_LOAD_TCNT2\@:                                                                    
 239               			NEG   R18                                         ;256-val                (  1 clock ) 
 240               			STS   SRTCNT2            , R18                    ;set val                (  2 clocks) 
 241               		KER_TIMER_LOAD_BSY\@:                                                                      
 242               	        LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 243               			SBRC  R18                , 0x04                   ;check bit4 TCN2UB      (  2 clocks) 
 244               			RJMP  KER_TIMER_LOAD_BSY\@                        ;jmp to label           (  2 clocks) 
 245               			LDI   R18                , 0x01                   ;load val               (  1 clock ) 
 246               			STS   SRTIFR2            , R18                    ;clear flag             (  2 clocks) 
 247               			STS   SRTIMSK2           , R18                    ;enable ovf interrupt   (  2 clocks) 
 248               	.endm                                                                                          
