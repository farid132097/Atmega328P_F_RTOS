 613               	Kernel_Task_Create:                                       ;total 21.50uS @8MHz    (172 clocks) 
 614:kernel.S      ****         KER_MSP_ZP_SAVE                                   ;push MSP and ZP        ( 10 clocks) 
 615               			;set priority to KerPrio                                                               
 616:kernel.S      **** 		LDI   R30                , lo8(KerPrio)           ;load low byte          (  1 clock ) 
 617:kernel.S      **** 		LDI   R31                , hi8(KerPrio)           ;load high byte         (  1 clock ) 
 618:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task id          (  2 clocks) 
 619:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 620:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 621:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 622:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 623               			;set sleep time to 0 in KerSleep to make the task ready                                
 624:kernel.S      **** 		LDI   R30                , lo8(KerSleep)          ;load low byte          (  1 clock ) 
 625:kernel.S      **** 		LDI   R31                , hi8(KerSleep)          ;load high byte         (  1 clock ) 
 626:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task id          (  2 clocks) 
 627:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 628:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 629:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 630:kernel.S      **** 		LDI   R18                , 0x00                   ;set sleep val to 0     (  1 clock ) 
 631:kernel.S      **** 		ST    Z                  , R18                    ;save status            (  2 clocks) 
 632               			;calculate stack top for current task (KerStack + KER_STK_SZ*(task id+1) - 1)          
 633:kernel.S      **** 		LDS   R18                , KerTID                 ;load task id           (  2 clocks) 
 634:kernel.S      **** 		INC   R18                                         ;increment task id      (  1 clock ) 
 635:kernel.S      **** 		LDI   R19                , KER_STK_SZ             ;load stack size        (  1 clock ) 
 636:kernel.S      **** 		MUL   R18                , R19                    ;multiply to get offset (  2 clocks) 
 637:kernel.S      **** 		MOV   R30                , R0                     ;load multiplied low    (  1 clocks) 
 638:kernel.S      **** 		MOV   R31                , R1                     ;load multiplied high   (  1 clocks) 
 639:kernel.S      **** 		CLR   R1                                          ;gcc expects cleared    (  1 clock ) 
 640:kernel.S      **** 		SBIW  R30                , 0x01                   ;dec multiplied val-1   (  2 clocks) 
 641:kernel.S      **** 		LDI   R18                , lo8(KerStack)          ;load base addr low     (  1 clock ) 
 642:kernel.S      **** 		LDI   R19                , hi8(KerStack)          ;load base addr high    (  1 clock ) 
 643:kernel.S      **** 		ADD   R30                , R18                    ;add low bytes          (  1 clock ) 
 644:kernel.S      **** 		ADC   R31                , R19                    ;add high bytes+carry   (  1 clock ) 
 645               			;set stack pointer                                                                     
 646:kernel.S      **** 		OUT   IOSPL              , R30                    ;load SPL               (  1 clock ) 
 647:kernel.S      ****         OUT   IOSPH              , R31                    ;load SPH               (  1 clock ) 
 648               			;function argument directly returns word address                                       
 649:kernel.S      **** 	    PUSH  R24                                         ;push word addr low     (  2 clocks) 
 650:kernel.S      **** 		PUSH  R25                                         ;push word addr high    (  2 clocks) 
 651               			;push context to stack of this task                                                    
 652:kernel.S      **** 		KER_CONTEXT_SAVE                                  ;save context           ( 68 clocks) 
 653               			;increment task_id                                                                     
 654:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 655:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 656:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 657               			;increment ntask                                                                       
 658:kernel.S      **** 		LDS   R18                , KerNTSK                ;load ntask             (  2 clocks) 
 659:kernel.S      **** 		INC   R18                                         ;increment ntask        (  1 clock ) 
 660:kernel.S      **** 		STS   KerNTSK            , R18                    ;store ntask            (  2 clocks) 
 661:kernel.S      **** 		KER_MSP_ZP_RESTORE                                ;pop MSP and ZP         ( 10 clocks) 
 662:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
