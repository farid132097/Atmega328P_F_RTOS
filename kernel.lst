  15               	
  16               	;;============================define user address or macro starting=========================;; 
  17               	.equ     KER_RLD,         0x00                            ;KER_RLD=0xFF-(F_CPU/KER_PRS/KER_TR) 
  18               	.equ     KER_STK_SZ,      128                             ;stack size in bytes for each task   
  19               	.equ     KER_MX_NTSK,     KER_MAX_TASK+1                  ;max number of tasks                 
  20               	;;==============================define user address or macro end============================;; 
  21               	
  22               	
  23               	
  24               	
  25               	
  26               	;;===============================define data offsets starting===============================;; 
  27               	.equ     OFB_TID  ,       0x00                            ;offset from KerBase task id         
  28               	.equ     OFB_LST  ,       0x01                            ;offset from KerBase lowest sleep    
  29               	.equ     OFB_STS  ,       0x03                            ;offset from KerBase task status     
  30               	.equ     OFB_SLP  ,       0x04                            ;offset from KerBase sleep duration  
  31               	.equ     OFB_PRIO ,       0x05                            ;offset from KerBase task priority   
  32               	;;==================================define data offsets end=================================;; 
  33               	
  34               	
  35               	
  36               	
  37               	
  38               	;;===========================define hardware reg address starting===========================;; 
  39               	;SRAM Mapped Addresses, LDS/STS can be used                                                    
  40               	.equ     SRASSR  ,        0xB6                            ;manually defined ASSR in SRAM       
  41               	.equ     SROCR2B ,        0xB4                            ;manually defined OCR2B in SRAM      
  42               	.equ     SROCR2A ,        0xB3                            ;manually defined OCR2A in SRAM      
  43               	.equ     SRTCNT2 ,        0xB2                            ;manually defined TNCT2 in SRAM      
  44               	.equ     SRTCCR2B,        0xB1                            ;manually defined TCCR2B in SRAM     
  45               	.equ     SRTCCR2A,        0xB0                            ;manually defined TCCR2A in SRAM     
  46               	.equ     SRADCSRA,        0x7A                            ;manually defined ADCSRA in SRAM     
  47               	.equ     SRTIMSK2,        0x70                            ;manually defined TIMSK2 in SRAM     
  48               	.equ     SRCLKPR ,        0x61                            ;manually defined CLKPR in SRAM      
  49               	.equ     SRSREG  ,        0x5F                            ;manually defined SREG in SRAM       
  50               	.equ     SRSPH   ,        0x5E                            ;manually defined SPH in SRAM        
  51               	.equ     SRSPL   ,        0x5D                            ;manually defined SPL in SRAM        
  52               	.equ     SRMCUCR ,        0x55                            ;manually defined MCUCR in SRAM      
  53               	.equ     SRMCUSR ,        0x54                            ;manually defined MCUSR in SRAM      
  54               	.equ     SRSMCR  ,        0x53                            ;manually defined SMCR in SRAM       
  55               	.equ     SRACSR  ,        0x50                            ;manually defined ACSR in SRAM       
  56               	.equ     SRTIFR2 ,        0x37                            ;manually defined TIFR2 in SRAM      
  57               	;IO Mapped Addresses, IN/OUT commands can be used                                              
  58               	.equ     IOSREG  ,        0x3F                            ;manually defined SREG in IO         
  59               	.equ     IOSPH   ,        0x3E                            ;manually defined SPH in IO          
  60               	.equ     IOSPL   ,        0x3D                            ;manually defined SPL in IO          
  61               	.equ     IOMCUCR ,        0x35                            ;manually defined MCUCR in IO        
  62               	.equ     IOMCUSR ,        0x34                            ;manually defined MCUSR in IO        
  63               	.equ     IOSMCR  ,        0x33                            ;manually defined SMCR in IO         
  64               	.equ     IOTIFR2 ,        0x17                            ;manually defined TIFR2 in IO        
