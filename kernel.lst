  62               	.global    KerMSPZP                                       ;declare space for storing MSP, ZP   
  63 0000 0000 0000 	KerMSPZP:  .skip 4                                        ;2 bytes for MSP, 2 bytes for ZP     
  64               	.global    KerTID                                         ;declare space for task id           
  65 0004 00        	KerTID:    .skip 1                                        ;single byte, max 0xff tasks         
  66               	.global    KerHPTID                                       ;declare space for hi prio task id   
  67 0005 00        	KerHPTID:  .skip 1                                        ;single byte, max 0xff tasks         
  68               	.global    KerNTSK                                        ;declare space for number of tasks   
  69 0006 00        	KerNTSK:   .skip 1                                        ;single byte, max 0xff tasks         
  70               	.global    KerLST                                         ;declare space for lowest sleep time 
  71 0007 00        	KerLST:    .skip 1                                        ;single byte, max 0xff unit sleep    
  72               	.global    KerSCHM                                        ;declare space for scheduler mode    
  73 0008 00        	KerSCHM:   .skip 1                                        ;single byte, mode 0 isr, 1 thread   
  74               	.global    KerINTST                                       ;declare space for interrupt state   
  75 0009 00        	KerINTST:  .skip 1                                        ;single byte for storing curr state  
  76               	.global    KerSleep                                       ;declare space for task sleep time   
  77 000a 0000 0000 	KerSleep:  .skip KER_MX_NTSK*1                            ;single byte for each task           
  77      0000 
  78               	.global    KerPrio                                        ;declare space for task priority     
  79 0010 0000 0000 	KerPrio:   .skip KER_MX_NTSK*1                            ;single byte for each task           
  79      0000 
  80               	.global    KerTSP                                         ;declare space for stack pointer     
  81 0016 0000 0000 	KerTSP:    .skip KER_MX_NTSK*2                            ;2 bytes for each task               
  81      0000 0000 
  81      0000 0000 
  82               	.global    KerStack                                       ;declare global space for stack      
  83 0022 0000 0000 	KerStack:  .skip KER_STK_SZ*KER_MX_NTSK                   ;KER_STK_SZ bytes for each task      
