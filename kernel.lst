 105               	;;=================================timer2 disable starting==================================;; 
 106               	;used registers          : R18                                                                 
 107               	;arg registers           : None                                                                
 108               	;return registers        : None                                                                
 109               	;unsafe access registers : R18                                                                 
 110               	.macro  KER_TIMER2_DISABLE                                ;1.75uS @8MHz           ( 14 clocks) 
 111               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 112               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 113               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 114               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 115               			STS   SROCR2B            , R18                    ;clear OCR2B            (  2 clocks) 
 116               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 117               	.endm                                                                                          
 118               	;;==================================timer2 disable end======================================;; 
