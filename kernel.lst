 648               	Kernel_Start_Tasks:                                       ;total 25.63uS @8MHz    (205 clocks) 
 649:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 650:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 651:kernel.S      **** 		KER_LOAD_TASK_ID_AND_SP                           ;load next task id, SP  ( 14 clocks) 
 652:kernel.S      **** 		KER_CONTEXT_RESTORE                               ;restore context        ( 68 clocks) 
 653:kernel.S      **** 		CALL  Kernel_Timer_Init                           ;timer init             (--- clocks) 
 654:kernel.S      **** 		SEI
 655:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
