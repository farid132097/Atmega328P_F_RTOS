  89               	.equ     IOSPH   ,        0x3E                            ;manually defined SPH in IO          
  90               	.equ     IOSPL   ,        0x3D                            ;manually defined SPL in IO          
  91               	.equ     IOMCUCR ,        0x35                            ;manually defined MCUCR in IO        
  92               	.equ     IOMCUSR ,        0x34                            ;manually defined MCUSR in IO        
  93               	.equ     IOSMCR  ,        0x33                            ;manually defined SMCR in IO         
