  53               	.equ     TASK_BLOCKED,    0x00                            ;KerSchSts val=0                     
  54               	.equ     TASK_READY,      0x01                            ;KerSchSts val=1                     
  55               	.equ     TASK_EXECUTING,  0x02                            ;KerSchSts val=2                     
  56               	.equ     TASK_SUSPENDED,  0x03                            ;KerSchSts val=3                     
  57               	.equ     TASK_CONS_LAT,   0x04                            ;KerSchSts val=3, constant latency   
  58               	.equ     SCH_MODE_HANDLER,0x00                            ;handler mode in KER_SLP_TIME_MGNT   
  59               	.equ     SCH_MODE_THREAD, 0x01                            ;thread mode in KER_SLP_TIME_MGNT    
