 206               	.macro  KER_TIMER_RELOAD                                  ;0.75uS @8MHz           (  6 clocks) 
 207               	        LDS   R18                , KerLST                 ;fetch lowst sleep time (  2 clocks) 
 208               			CPI   R18                , 0x15                   ;compare with 21        (  1 clock ) 
 209               			BRCS  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 210               			CPI   R18                , 0x3F                   ;compare with 63        (  1 clock ) 
 211               			BRCC  _KER_TIMER_RLD_CMP105\@                     ;jmp to label           (  2 clocks) 
 212               			SUBI  R18                , 0xFF                   ;add 1                  (  1 clock ) 
 213               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 214               		_KER_TIMER_RLD_CMP105\@:
 215               			CPI   R18                , 0x69                   ;compare with 105       (  1 clock ) 
 216               			BRCC  _KER_TIMER_RLD_CMP146\@                     ;jmp to label           (  2 clocks) 
 217               			SUBI  R18                , 0xFE                   ;add 2                  (  1 clock ) 
 218               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 219               		_KER_TIMER_RLD_CMP146\@:
 220               			CPI   R18                , 0x92                   ;compare with 146       (  1 clock ) 
 221               			BRCC  _KER_TIMER_RLD_CMP188\@                     ;jmp to label           (  2 clocks) 
 222               			SUBI  R18                , 0xFD                   ;add 3                  (  1 clock ) 
 223               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 224               		_KER_TIMER_RLD_CMP188\@:
 225               			CPI   R18                , 0xBC                   ;compare with 188       (  1 clock ) 
 226               			BRCC  _KER_TIMER_RLD_CMP230\@                     ;jmp to label           (  2 clocks) 
 227               			SUBI  R18                , 0xFC                   ;add 4                  (  1 clock ) 
 228               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 229               		_KER_TIMER_RLD_CMP230\@:
 230               			CPI   R18                , 0xE6                   ;compare with 230       (  1 clock ) 
 231               			BRCC  _KER_TIMER_RLD_ELSE\@                       ;jmp to label           (  2 clocks) 
 232               			SUBI  R18                , 0xFB                   ;add 5                  (  1 clock ) 
 233               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 234               		_KER_TIMER_RLD_ELSE\@:
 235               			SUBI  R18                , 0xFA                   ;add 6                  (  1 clock ) 
 236               			RJMP  _KER_TIMER_LOAD_TCNT2\@                     ;jmp to label           (  2 clocks) 
 237               		_KER_TIMER_LOAD_TCNT2\@:
 238               			NEG   R18                                         ;256-val                (  1 clock ) 
 239               			STS   SRTCNT2            , R18                    ;set val                (  2 clocks) 
 240               		_KER_TIMER_LOAD_BSY\@:
 241               	        LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 242               			SBRC  R18                , 0x04                   ;check bit4 TCN2UB      (  2 clocks) 
 243               			RJMP  _KER_TIMER_LOAD_BSY\@                       ;jmp to label           (  2 clocks) 
 244               			LDI   R18                , 0x01                   ;load val               (  1 clock ) 
 245               			STS   SRTIFR2            , R18                    ;store val              (  2 clocks) 
 246               			STS   SRTIMSK2           , R18                    ;store val              (  2 clocks) 
 247               	.endm                                                                                          
