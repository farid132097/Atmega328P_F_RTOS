 637:kernel.S      **** 		STS   KerLST             , R24                    ;store val              (  2 clocks) 
 638:kernel.S      **** 		KER_TIMER_RELOAD_MS                               ;reload val             (--- clocks) 
 639:kernel.S      **** 		KER_ENTER_SLEEP
 640:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
