 446               	.macro  KER_RUN_SCHEDULER                                 ;total 0.25uS @8MHz     (  2 clocks) 
 447               			LDI   R18                , 0x00                   ;start from tid 0       (  1 clock ) 
 448               			LDS   R19                , KerNTSK                ;load val               (  2 clocks) 
 449               			LDI   R20                , 0xFF                   ;local lowest time      (  1 clock ) 
 450               			LDS   R21                , KerLST                 ;load lowest time       (  2 clocks) 
 451               			LDI   R30                , lo8(KerSleep)          ;load sleep reg low     (  1 clock ) 
 452               			LDI   R31                , hi8(KerSleep)          ;load sleep reg high    (  1 clock ) 
 453               	    _KER_SCH_LOOP1\@:
 454               		    LD    R22                , Z                      ;load sleep val         (  2 clocks) 
 455               			TST   R22                                         ;check val              (  1 clock ) 
 456               			BREQ  _KER_SCH_SKIP1\@                            ;skip subtract          (  2 clocks) 
 457               			SUB   R22                , R21                    ;subtract LST           (  1 clock ) 
 458               			ST    Z+                 , R22                    ;store new val          (  2 clocks) 
 459               		_KER_SCH_SKIP1\@:
 460               		    CP    R22                , R20                    ;compare                (  1 clock ) 
 461               			BRSH  _KER_SCH_LCI1\@                             ;
 462               			MOV   R20                , R22                    ;copy lowest val        
 463               	    _KER_SCH_LCI1\@:                                      ;loop counter increment              
 464               			INC   R18                                         ;increment              (  1 clock ) 
 465               		    CP    R18                , R19                    ;compare with ntask     (  2 clocks) 
 466               			BRLO  _KER_SCH_LOOP1\@                            ;if task id<ntask       (  2 clocks) 
 467               	    _KER_SCH_EXIT1\@:
 468               		    STS   KerLST             , R20                    ;save LST               (  2 clocks) 
 469               	
 470               			LDI   R18                , 0x00                   ;start from tid 0       (  1 clock ) 
 471               			LDS   R19                , KerNTSK                ;load val               (  2 clocks) 
 472               			LDI   R20                , 0xFF                   ;local hi prio          (  1 clock ) 
 473               			LDS   R21                , KerLST                 ;load lowest time       (  2 clocks) 
 474               			LDI   R30                , lo8(KerSleep)          ;load sleep reg low     (  1 clock ) 
 475               			LDI   R31                , hi8(KerSleep)          ;load sleep reg high    (  1 clock ) 
 476               	    _KER_SCH_LOOP2\@:
 477               		    LD    R22                , Z                      ;load sleep val         (  2 clocks) 
 478               			TST   R22                                         ;check val              (  1 clock ) 
 479               			BREQ  _KER_SCH_SKIP2\@                            ;skip subtract          (  2 clocks) 
 480               			
 481               		_KER_SCH_SKIP2\@:
 482               		    CP    R22                , R20                    ;compare                (  1 clock ) 
 483               			BRSH  _KER_SCH_LCI2\@                             ;
 484               			MOV   R20                , R22                    ;copy lowest val        
 485               	    _KER_SCH_LCI2\@:                                      ;loop counter increment              
 486               			INC   R18                                         ;increment              (  1 clock ) 
 487               		    CP    R18                , R19                    ;compare with ntask     (  2 clocks) 
 488               			BRLO  _KER_SCH_LOOP2\@                            ;if task id<ntask       (  2 clocks) 
 489               	    _KER_SCH_EXIT2\@:
 490               		    STS   KerLST             , R20                    ;save LST               (  2 clocks) 
 491               	.endm                                                                                          
