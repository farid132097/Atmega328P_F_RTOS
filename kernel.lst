 186               	;;===============================timer2 async init starting=================================;; 
 187               	;used registers          : R18, R19                                                            
 188               	;arg registers           : None                                                                
 189               	;return registers        : None                                                                
 190               	;unsafe access registers : R18, R19                                                            
 191               	.macro  KER_TIMER2_ASYNC_INIT                             ;~9.13uS @8MHz          (~73 clocks) 
 192               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 193               			STS   SRTCCR2B           , R18                    ;stop timer             (  2 clocks) 
 194               			STS   SRTIMSK2           , R18                    ;clear TIMSK2           (  2 clocks) 
 195               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 196               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 197               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 198               			STS   SROCR2A            , R18                    ;clear compare reg      (  2 clocks) 
 199               			STS   SROCR2B            , R18                    ;clear compare reg      (  2 clocks) 
 200               			STS   SRTCCR2A           , R18                    ;clear controlA reg     (  2 clocks) 
 201               			LDI   R18                , 0x03                   ;prescaler 3            (  1 clock ) 
 202               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 203               			LDI   R18                , KER_RLD                ;clear reg              (  1 clock ) 
 204               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 205               		_KER_TC2_AUB\@:                                                                            
 206               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 207               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 208               			BRNE  _KER_TC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 209               		_KER_TC2_BUB\@:                                                                            
 210               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 211               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 212               			BRNE  _KER_TC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 213               		_KER_OC2_AUB\@:                                                                            
 214               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 215               	        ANDI  R18                , 0x08                   ;check bit OR2AUB       (  1 clock ) 
 216               			BRNE  _KER_OC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 217               		_KER_OC2_BUB\@:                                                                            
 218               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 219               	        ANDI  R18                , 0x04                   ;check bit OCR2BUB      (  1 clock ) 
 220               			BRNE  _KER_OC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 221               		_KER_TC2_UB\@:                                                                             
 222               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 223               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 224               			BRNE  _KER_TC2_UB\@                               ;wait until UB cleared  (  2 clocks) 
 225               		_KER_TC2_TOV2\@:                                                                           
 226               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 227               	        ANDI  R18                , 0x01                   ;check bit TOV2         (  1 clock ) 
 228               	        BREQ  _KER_TC2_OCF2A\@                            ;bit cleared, jump next (  2 clocks) 
 229               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 230               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 231               	    _KER_TC2_OCF2A\@:                                                                          
 232               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 233               	        ANDI  R18                , 0x02                   ;check bit OCF2A        (  1 clock ) 
 234               	        BREQ  _KER_TC2_OCF2B\@                            ;bit cleared, jump next (  2 clocks) 
 235               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 236               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 237               		_KER_TC2_OCF2B\@:                                                                          
 238               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 239               	        ANDI  R18                , 0x04                   ;check bit OCF2B        (  1 clock ) 
 240               	        BREQ  _KER_TC2_INTEN\@                            ;bit cleared, jump next (  2 clocks) 
 241               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 242               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 243               	    _KER_TC2_INTEN\@:                                                                          
 244               			LDI   R18                , 0x01                   ;set TOIE2 bit          (  1 clock ) 
 245               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 246               	.endm                                                                                          
 247               	;;=================================timer2 async init end====================================;; 
