 165               	;;=================================timer2 disable starting==================================;; 
 166               	;used registers          : R18                                                                 
 167               	;arg registers           : None                                                                
 168               	;return registers        : None                                                                
 169               	;unsafe access registers : R18                                                                 
 170               	.macro  KER_TIMER2_DISABLE                                ;1.75uS @8MHz           ( 14 clocks) 
 171               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 172               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 173               			LDI   R18                , 0x00                   ;clear reg              (  1 clock ) 
 174               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 175               			LDI   R18                , 0x00                   ;clear AS2 bit          (  1 clock ) 
 176               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 177               			LDI   R18                , 0x00                   ;set val to reg         (  1 clock ) 
 178               			STS   SROCR2B            , R18                    ;clear OCR2B            (  2 clocks) 
 179               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 180               	.endm                                                                                          
 181               	;;==================================timer2 disable end======================================;; 
 182               	
