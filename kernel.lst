 410               	.macro  KER_RUN_SCHEDULER                                 ;total 0.25uS @8MHz     (  2 clocks) 
 411               			LDS   R18                , KerTID                 ;load val               (  2 clocks) 
 412               			LDS   R19                , KerNTSK                ;load ntask             (  2 clocks) 
 413               			LDI   R20                , 0x01                   ;set val                (  1 clock ) 
 414               			ADD   R18                , R20                    ;increment val          (  1 clock ) 
 415               			CP    R18                , R19                    ;compare val            (  1 clock ) 
 416               			BRLO  KER_SCH_ASSN\@                                                                   
 417               			LDI   R18                , 0x00                   ;roll back              (  1 clock ) 
 418               		KER_SCH_ASSN\@:                                                                            
 419               		    STS   KerTID             , R18                    ;save val               (  2 clocks) 
 420               	.endm                                                                                          
