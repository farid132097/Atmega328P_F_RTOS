 509               	Kernel_Vars_Init:                                         ;total 1.875uS @8MHz    ( 15 clocks) 
 510:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 511:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 512:kernel.S      **** 		STS   KerHPTID           , R18                    ;store hi prio task_id  (  2 clocks) 
 513:kernel.S      **** 		STS   KerNTSK            , R18                    ;store ntask            (  2 clocks) 
 514:kernel.S      **** 		STS   KerLST             , R18                    ;store lowest sleep dur (  2 clocks) 
 515:kernel.S      **** 		STS   KerSCHM            , R18                    ;store scheduler mode   (  2 clocks) 
 516:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
 517               	
 518               	
 519               	
 520               	Kernel_Task_Create:                                       ;total 21.50uS @8MHz    (172 clocks) 
 521:kernel.S      **** 		KER_MSP_ZP_SAVE                                   ;push MSP and ZP        ( 18 clocks) 
 522               			;set priority to KerPrio+task_id                                                       
 523:kernel.S      **** 		LDI   R30                , lo8(KerPrio)           ;load low byte          (  1 clock ) 
 524:kernel.S      **** 		LDI   R31                , hi8(KerPrio)           ;load high byte         (  1 clock ) 
 525:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 526:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 527:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 528:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 529:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 530               	
 531               			;set task status to KerSleep+task_id                                                  
 532:kernel.S      **** 		LDI   R30                , lo8(KerSleep)          ;load low byte          (  1 clock ) 
 533:kernel.S      **** 		LDI   R31                , hi8(KerSleep)          ;load high byte         (  1 clock ) 
 534:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 535:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 536:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 537:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 538:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 539:kernel.S      **** 		LDI   R18                , 0x00                   ;set sleep time->ready  (  1 clock ) 
 540:kernel.S      **** 		ST    Z                  , R18                    ;save status            (  2 clocks) 
 541               	
 542               			;stack pointer for current task (KerStack + KER_STK_SZ*(task_id+1) - 1) ->stack top    
 543:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 544:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 545:kernel.S      **** 		LDI   R19                , KER_STK_SZ             ;load stack size        (  1 clock ) 
 546:kernel.S      **** 		MUL   R18                , R19                    ;multiply to get offset (  2 clocks) 
 547:kernel.S      **** 		MOV   R30                , R0                     ;load multiplied low    (  1 clocks) 
 548:kernel.S      **** 		MOV   R31                , R1                     ;load multiplied high   (  1 clocks) 
 549:kernel.S      **** 		SBIW  R30                , 0x01                   ;dec multiplied val-1   (  2 clocks) 
 550:kernel.S      **** 		CLR   R1                                          ;gcc expects cleared    (  1 clock ) 
 551:kernel.S      **** 		LDI   R18                , lo8(KerStack)          ;load base addr low     (  1 clock ) 
 552:kernel.S      **** 		LDI   R19                , hi8(KerStack)          ;load base addr high    (  1 clock ) 
 553:kernel.S      **** 		ADD   R30                , R18                    ;add low bytes          (  1 clock ) 
 554:kernel.S      **** 		ADC   R31                , R19                    ;add high bytes+carry   (  1 clock ) 
 555:kernel.S      **** 		OUT   IOSPL              , R30                    ;load SPL               (  1 clock ) 
 556:kernel.S      ****         OUT   IOSPH              , R31                    ;load SPH               (  1 clock ) 
 557               			;function argument directly returns word address                                       
 558:kernel.S      **** 	    PUSH  R24                                         ;push word addr low     (  2 clocks) 
 559:kernel.S      **** 		PUSH  R25                                         ;push word addr high    (  2 clocks) 
 560               			;push context to stack of this task                                                    
 561:kernel.S      **** 		SEI                                               ;enable interrupt       (  1 clock ) 
 562:kernel.S      **** 		KER_CONTEXT_SAVE                                  ;save context           ( 68 clocks) 
 563               			;read stack pointer of current task (necessary when restore)                           
 564:kernel.S      **** 		IN    R18                , IOSPL                  ;read SPL               (  1 clock ) 
 565:kernel.S      ****         IN    R19                , IOSPH                  ;read SPH               (  1 clock ) 
 566               			;calculate the address where current task's SP will be stored and store SP             
 567:kernel.S      **** 		LDS   R20                , KerTID                 ;load task_id           (  2 clocks) 
 568:kernel.S      **** 		LSL   R20                                         ;left shift to multiply (  1 clock ) 
 569:kernel.S      **** 		LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 570:kernel.S      **** 		LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 571:kernel.S      **** 		ADD   R30                , R20                    ;add offset to array    (  1 clock ) 
 572:kernel.S      **** 		LDI   R20                , 0x00                   ;clear reg              (  1 clock ) 
 573:kernel.S      **** 		ADC   R31                , R20                    ;add carry if any       (  1 clock ) 
 574:kernel.S      **** 		ST    Z+                 , R18                    ;SPL at KerTSP+offset   (  2 clocks) 
 575:kernel.S      **** 		ST    Z                  , R19                    ;SPH at KerTSP+offset   (  2 clocks) 
 576               			;increment task_id                                                                     
 577:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 578:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 579:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 580               			;increment ntask                                                                       
 581:kernel.S      **** 		LDS   R18                , KerNTSK                ;load ntask             (  2 clocks) 
 582:kernel.S      **** 		INC   R18                                         ;increment ntask        (  1 clock ) 
 583:kernel.S      **** 		STS   KerNTSK   , R18                             ;store ntask            (  2 clocks) 
 584:kernel.S      **** 		KER_MSP_ZP_RESTORE                                ;pop MSP and ZP         ( 18 clocks) 
 585:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
