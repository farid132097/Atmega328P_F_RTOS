 603               	Kernel_Init:                                              ;total 39.75uS @8MHz    (318 clocks) 
 604:kernel.S      ****         CLI                                               ;clear interrupt        (  1 clock ) 
 605:kernel.S      **** 		KER_MSP_ZP_SAVE                                   ;push MSP and ZP        ( 18 clocks) 
 606:kernel.S      **** 		KER_DEBUG_PIN_INIT                                ;debug pin init         (  4 clocks) 
 607:kernel.S      **** 		CALL  Kernel_Vars_Init                            ;variables init         ( 15 clocks) 
 608               			
 609:kernel.S      **** 		KER_MSP_ZP_RESTORE                                ;pop MSP and ZP         ( 18 clocks) 
 610:kernel.S      **** 		LDI   R24                , lo8(Kernel_Task_Idle)  ;load func addr low     (  1 clock ) 
 611:kernel.S      **** 		LDI   R25                , hi8(Kernel_Task_Idle)  ;load func addr high    (  1 clock ) 
 612:kernel.S      **** 		LSR   R25                                         ;right shift to divide  (  1 clock ) 
 613:kernel.S      **** 		ROR   R24                                         ;rotate right th carry  (  1 clock ) 
 614:kernel.S      **** 		LDI   R22                , 0xFF                   ;set max val            (  1 clock ) 
 615:kernel.S      **** 		CALL  Kernel_Task_Create
 616:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
