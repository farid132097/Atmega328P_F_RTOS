  68               	.equ     SRASSR  ,        0xB6                            ;manually defined ASSR in SRAM       
  69               	.equ     SROCR2B ,        0xB4                            ;manually defined OCR2B in SRAM      
  70               	.equ     SROCR2A ,        0xB3                            ;manually defined OCR2A in SRAM      
  71               	.equ     SRTCNT2 ,        0xB2                            ;manually defined TNCT2 in SRAM      
  72               	.equ     SRTCCR2B,        0xB1                            ;manually defined TCCR2B in SRAM     
  73               	.equ     SRTCCR2A,        0xB0                            ;manually defined TCCR2A in SRAM     
  74               	.equ     SRADMUX ,        0x7C                            ;manually defined ADMUX in SRAM      
  75               	.equ     SRADCSRA,        0x7A                            ;manually defined ADCSRA in SRAM     
  76               	.equ     SRTIMSK2,        0x70                            ;manually defined TIMSK2 in SRAM     
  77               	.equ     SRCLKPR ,        0x61                            ;manually defined CLKPR in SRAM      
  78               	.equ     SRWDTCSR,        0x60                            ;manually defined WDTCSR in SRAM     
  79               	.equ     SRSREG  ,        0x5F                            ;manually defined SREG in SRAM       
  80               	.equ     SRSPH   ,        0x5E                            ;manually defined SPH in SRAM        
  81               	.equ     SRSPL   ,        0x5D                            ;manually defined SPL in SRAM        
  82               	.equ     SRMCUCR ,        0x55                            ;manually defined MCUCR in SRAM      
  83               	.equ     SRMCUSR ,        0x54                            ;manually defined MCUSR in SRAM      
  84               	.equ     SRSMCR  ,        0x53                            ;manually defined SMCR in SRAM       
  85               	.equ     SRACSR  ,        0x50                            ;manually defined ACSR in SRAM       
  86               	.equ     SRTIFR2 ,        0x37                            ;manually defined TIFR2 in SRAM      
  87               	;IO Mapped Addresses, IN/OUT commands can be used                                              
