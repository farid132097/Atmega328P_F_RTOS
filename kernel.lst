 257               	;unsafe access registers : R18, R19                                                            
 258               	.macro  KER_TIMER_INIT                                    ;~9.13uS max @8MHz      (~73 clocks) 
 259               			KER_TIMER2_ASYNC_INIT                             ;total 1.5uS @8MHz      (~73 clocks) 
 260               	.endm                                                                                          
 261               	;;======================================timer init end======================================;; 
