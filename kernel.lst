 198               	.macro  KER_TIMER_RELOAD                                  ;0.5uS @8MHz            (  4 clocks) 
 199               	        LDS   R18                , KerBase+OFB_LST        ;fetch lowst sleep time (  2 clocks) 
 200               			STS   SRTCNT2            , R18                    ;set val                (  2 clocks) 
 201               	.endm                                                                                          
