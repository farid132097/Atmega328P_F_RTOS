 607               	Kernel_Task_Create:                                       ;total 21.50uS @8MHz    (172 clocks) 
 608:kernel.S      ****         KER_MSP_ZP_SAVE                                   ;push MSP and ZP        ( 10 clocks) 
 609               			;set priority to KerPrio                                                               
 610:kernel.S      **** 		LDI   R30                , lo8(KerPrio)           ;load low byte          (  1 clock ) 
 611:kernel.S      **** 		LDI   R31                , hi8(KerPrio)           ;load high byte         (  1 clock ) 
 612:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task id          (  2 clocks) 
 613:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 614:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 615:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 616:kernel.S      **** 		ST    Z                  , R22                    ;save priority          (  2 clocks) 
 617               			;set sleep time to 0 in KerSleep to make the task ready                                
 618:kernel.S      **** 		LDI   R30                , lo8(KerSleep)          ;load low byte          (  1 clock ) 
 619:kernel.S      **** 		LDI   R31                , hi8(KerSleep)          ;load high byte         (  1 clock ) 
 620:kernel.S      **** 		LDS   R18                , KerTID                 ;fetch task id          (  2 clocks) 
 621:kernel.S      **** 		ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 622:kernel.S      **** 		LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 623:kernel.S      **** 		ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 624:kernel.S      **** 		LDI   R18                , 0x00                   ;set sleep val to 0     (  1 clock ) 
 625:kernel.S      **** 		ST    Z                  , R18                    ;save status            (  2 clocks) 
 626               			;calculate stack top for current task (KerStack + KER_STK_SZ*(task id+1) - 1)          
 627:kernel.S      **** 		LDS   R18                , KerTID                 ;load task id           (  2 clocks) 
 628:kernel.S      **** 		INC   R18                                         ;increment task id      (  1 clock ) 
 629:kernel.S      **** 		LDI   R19                , KER_STK_SZ             ;load stack size        (  1 clock ) 
 630:kernel.S      **** 		MUL   R18                , R19                    ;multiply to get offset (  2 clocks) 
 631:kernel.S      **** 		MOV   R30                , R0                     ;load multiplied low    (  1 clocks) 
 632:kernel.S      **** 		MOV   R31                , R1                     ;load multiplied high   (  1 clocks) 
 633:kernel.S      **** 		CLR   R1                                          ;gcc expects cleared    (  1 clock ) 
 634:kernel.S      **** 		SBIW  R30                , 0x01                   ;dec multiplied val-1   (  2 clocks) 
 635:kernel.S      **** 		LDI   R18                , lo8(KerStack)          ;load base addr low     (  1 clock ) 
 636:kernel.S      **** 		LDI   R19                , hi8(KerStack)          ;load base addr high    (  1 clock ) 
 637:kernel.S      **** 		ADD   R30                , R18                    ;add low bytes          (  1 clock ) 
 638:kernel.S      **** 		ADC   R31                , R19                    ;add high bytes+carry   (  1 clock ) 
 639               			;set stack pointer                                                                     
 640:kernel.S      **** 		OUT   IOSPL              , R30                    ;load SPL               (  1 clock ) 
 641:kernel.S      ****         OUT   IOSPH              , R31                    ;load SPH               (  1 clock ) 
 642               			;function argument directly returns word address                                       
 643:kernel.S      **** 	    PUSH  R24                                         ;push word addr low     (  2 clocks) 
 644:kernel.S      **** 		PUSH  R25                                         ;push word addr high    (  2 clocks) 
 645               			;push context to stack of this task                                                    
 646:kernel.S      **** 		SEI                                               ;enable interrupt       (  1 clock )
 647:kernel.S      **** 		KER_CONTEXT_SAVE                                  ;save context           ( 68 clocks)
 648:kernel.S      **** 		CLI                                               ;disable interrupt      (  1 clock ) 
 649               			;increment task_id                                                                     
 650:kernel.S      **** 		LDS   R18                , KerTID                 ;load task_id           (  2 clocks) 
 651:kernel.S      **** 		INC   R18                                         ;increment task_id      (  1 clock ) 
 652:kernel.S      **** 		STS   KerTID             , R18                    ;store task_id          (  2 clocks) 
 653               			;increment ntask                                                                       
 654:kernel.S      **** 		LDS   R18                , KerNTSK                ;load ntask             (  2 clocks) 
 655:kernel.S      **** 		INC   R18                                         ;increment ntask        (  1 clock ) 
 656:kernel.S      **** 		STS   KerNTSK            , R18                    ;store ntask            (  2 clocks) 
 657:kernel.S      **** 		KER_MSP_ZP_RESTORE                                ;pop MSP and ZP         ( 10 clocks) 
 658:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
 659               	;;==================================kernel task create end==================================;; 
