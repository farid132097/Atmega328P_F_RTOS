  18               	;;============================define user address or macro starting=========================;; 
  19               	.equ     KER_RLD,         0x00                            ;clear                               
  20               	.equ     KER_STK_SZ,      128                             ;stack size in bytes for each task   
  21               	.equ     KER_MX_NTSK,     KER_MAX_TASK+1                  ;max number of tasks                 
  22               	;;==============================define user address or macro end============================;; 
  23               	
  24               	
  25               	
  26               	
  27               	
  28               	;;===============================define data offsets starting===============================;; 
  29               	.equ     OFB_TICK0,       0x00                            ;offset from KerBase tick count byte0
  30               	.equ     OFB_TICK1,       0x01                            ;offset from KerBase tick count byte1
  31               	.equ     OFB_TICK2,       0x02                            ;offset from KerBase tick count byte2
  32               	.equ     OFB_TICK3,       0x03                            ;offset from KerBase tick count byte3
  33               	.equ     OFB_TICK4,       0x04                            ;offset from KerBase tick count byte4
  34               	.equ     OFB_PRS  ,       0x05                            ;offset from KerBase prescaler       
  35               	.equ     OFB_RLD  ,       0x06                            ;offset from KerBase counter reload  
  36               	.equ     OFB_TID  ,       0x07                            ;offset from KerBase task id         
  37               	.equ     OFB_NTSK ,       0x08                            ;offset from KerBase ntask           
  38               	.equ     OFB_LPR  ,       0x09                            ;offset from KerBase lowest priority 
  39               	.equ     OFB_PTID ,       0x0A                            ;offset from KerBase prio task_id    
  40               	.equ     OFB_UTC  ,       0x0B                            ;offset from KerBase usage tick cnt  
  41               	.equ     OFB_UATC ,       0x0C                            ;offset from KerBase active tick cnt 
  42               	.equ     OFB_USAGE,       0x0D                            ;offset from KerBase cpu usage       
  43               	.equ     OFB_SLCFG,       0x0E                            ;offset from KerBase sleep config    
  44               	.equ     OFM_MSPI ,       0x00                            ;offset from MSPZP msp index field   
  45               	.equ     OFM_MSPS ,       0x02                            ;offset from MSPZP msp starting      
  46               	;;==================================define data offsets end=================================;; 
