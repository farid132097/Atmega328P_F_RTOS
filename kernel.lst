 414               	.macro KER_DISABLE_ANALOG_DOMAIN                          ;total 0.75uS @8MHz     ( 10 clocks) 
 415               	    #if defined(KER_IDLE_AS_SLEEP)
 416               			LDS   R18                , SRADCSRA               ;load ADCSRA            (  2 clocks) 
 417               			ANDI  R18                , 0x7F                   ;clear ADEN             (  1 clock ) 
 418               			STS   SRADCSRA           , R18                    ;set val                (  2 clocks) 
 419               			LDS   R18                , SRACSR                 ;load ACSR              (  2 clocks) 
 420               			ORI   R18                , 0x80                   ;set ACD                (  1 clock ) 
 421               			STS   SRACSR             , R18                    ;set val                (  2 clocks) 
 422               		#endif                                                                                     
 423               	.endm                                                                                          
