 799               	;;================================calc cpu usage starting===================================;; 
 800               	;used registers          : R18, R19                                                            
 801               	;arg registers           : None                                                                
 802               	;return registers        : None                                                                
 803               	;unsafe access registers : R18, R19                                                            
 804               	.macro  KER_CPU_USAGE                                     ;total 3.25uS @8MHz     ( 26 clocks) 
 805               	        #ifdef KER_CPU_USAGE_CALC_ENABLE                                                       
 806               	        ;check if current target task is idle task or not                                      
 807               	        LDS    R18               , KerBase+OFB_TID        ;load target task_id    (  2 clocks) 
 808               			TST    R18                                        ;check if idle task     (  1 clock ) 
 809               			BREQ   _KER_USG_TICK\@                            ;task_id=idle, skip     (  2 clocks) 
 810               			LDS    R18               , KerBase+OFB_UATC       ;load active tick cnt   (  2 clocks) 
 811               			INC    R18                                        ;inc active tick cnt    (  1 clock ) 
 812               			STS    KerBase+OFB_UATC  , R18                    ;store new val          (  2 clocks) 
 813               		_KER_USG_TICK\@:                                                                           
 814               			LDS    R18               , KerBase+OFB_UTC        ;load usage tick cnt    (  2 clocks) 
 815               			INC    R18                                        ;increment tick cnt     (  1 clock ) 
 816               			CPI    R18               , 100                    ;compare with 100       (  1 clock ) 
 817               			BRLO   _KER_USG_UTC_SV\@                          ;val<100, save new val  (  2 clocks) 
 818               			LDI    R18               , 0x00                   ;val>=100, roll back    (  1 clock ) 
 819               			LDS    R19               , KerBase+OFB_UATC       ;load active tick cnt   (  2 clocks) 
 820               			STS    KerBase+OFB_USAGE , R19                    ;store usage            (  2 clocks) 
 821               			LDI    R19               , 0x00                   ;clear reg              (  1 clock ) 
 822               			STS    KerBase+OFB_UATC  , R19                    ;clear active tick cnt  (  2 clocks) 
 823               		_KER_USG_UTC_SV\@:                                                                         
 824               			STS    KerBase+OFB_UTC   , R18                    ;store new val          (  2 clocks) 
 825               			#endif                                                                                 
 826               	.endm                                                                                          
