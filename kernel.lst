 156               	.macro  KER_INTERRUPT_STATE_RESTORE                       ;total 0.625uS @8MHz    (  5 clocks) 
 157               	        LDS   R18                , KerINTST               ;load interrupt state   (  2 clocks) 
 158               			SBRC  R18                , 0x07                   ;check bit7 (I bit)     (  2 clocks) 
 159               			SEI                                               ;enable interrupt       (  1 clock ) 
 160               	.endm                                                                                          
