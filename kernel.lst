 250               			PUSH  R11                                         ;save R11               (  2 clocks) 
 251               			PUSH  R12                                         ;save R12               (  2 clocks) 
 252               			PUSH  R13                                         ;save R13               (  2 clocks) 
 253               			PUSH  R14                                         ;save R14               (  2 clocks) 
 254               			PUSH  R15                                         ;save R15               (  2 clocks) 
 255               			PUSH  R16                                         ;save R16               (  2 clocks) 
 256               			PUSH  R17                                         ;save R17               (  2 clocks) 
 257               			PUSH  R18                                         ;save R18               (  2 clocks) 
 258               			PUSH  R19                                         ;save R19               (  2 clocks) 
 259               			PUSH  R20                                         ;save R20               (  2 clocks) 
 260               			PUSH  R21                                         ;save R21               (  2 clocks) 
 261               			PUSH  R22                                         ;save R22               (  2 clocks) 
 262               			PUSH  R23                                         ;save R23               (  2 clocks) 
 263               			PUSH  R24                                         ;save R24               (  2 clocks) 
 264               			PUSH  R25                                         ;save R25               (  2 clocks) 
 265               			PUSH  R26                                         ;save R26               (  2 clocks) 
 266               			PUSH  R27                                         ;save R27               (  2 clocks) 
 267               			PUSH  R28                                         ;save R28               (  2 clocks) 
 268               			PUSH  R29                                         ;save R29               (  2 clocks) 
 269               			PUSH  R30                                         ;save R30               (  2 clocks) 
 270               			PUSH  R31                                         ;save R31               (  2 clocks) 
 271               	.endm                                                                                          
 272               	;;======================================save r0~r31 end=====================================;; 
