 354               	;;=================================context restore starting=================================;; 
 355               	;used registers          : R0~R31                                                              
 356               	;arg registers           : None                                                                
 357               	;return registers        : None                                                                
 358               	;unsafe access registers : None                                                                
 359               	.macro  KER_CONTEXT_RESTORE                               ;total 8.38uS @8MHz     ( 81 clocks) 
 360               	        LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 361               			LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 362               			LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 363               			LSL   R18                                         ;left shift to multiply (  1 clock ) 
 364               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 365               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 366               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 367               			LDD   R18                , Z+0                    ;load SPL at ZP         (  2 clocks) 
 368               			LDD   R19                , Z+1                    ;load SPH at ZP         (  2 clocks) 
 369               			OUT   IOSPL              , R18                    ;load SPL0              (  1 clock ) 
 370               			OUT   IOSPH              , R19                    ;load SPH0              (  1 clock ) 
 371               			POP   R31                                         ;restore R31            (  2 clocks) 
 372               			POP   R30                                         ;restore R30            (  2 clocks) 
 373               			POP   R29                                         ;restore R29            (  2 clocks) 
 374               			POP   R28                                         ;restore R28            (  2 clocks) 
 375               			POP   R27                                         ;restore R27            (  2 clocks) 
 376               			POP   R26                                         ;restore R26            (  2 clocks) 
 377               			POP   R25                                         ;restore R25            (  2 clocks) 
 378               			POP   R24                                         ;restore R24            (  2 clocks) 
 379               			POP   R23                                         ;restore R23            (  2 clocks) 
 380               			POP   R22                                         ;restore R22            (  2 clocks) 
 381               			POP   R21                                         ;restore R21            (  2 clocks) 
 382               			POP   R20                                         ;restore R20            (  2 clocks) 
 383               			POP   R19                                         ;restore R19            (  2 clocks) 
 384               			POP   R18                                         ;restore R18            (  2 clocks) 
 385               			POP   R17                                         ;restore R17            (  2 clocks) 
 386               			POP   R16                                         ;restore R16            (  2 clocks) 
 387               			POP   R15                                         ;restore R15            (  2 clocks) 
 388               			POP   R14                                         ;restore R14            (  2 clocks) 
 389               			POP   R13                                         ;restore R13            (  2 clocks) 
 390               			POP   R12                                         ;restore R12            (  2 clocks) 
 391               			POP   R11                                         ;restore R11            (  2 clocks) 
 392               			POP   R10                                         ;restore R10            (  2 clocks) 
 393               			POP   R9                                          ;restore R9             (  2 clocks) 
 394               			POP   R8                                          ;restore R8             (  2 clocks) 
 395               			POP   R7                                          ;restore R7             (  2 clocks) 
 396               			POP   R6                                          ;restore R6             (  2 clocks) 
 397               			POP   R5                                          ;restore R5             (  2 clocks) 
 398               			POP   R4                                          ;restore R4             (  2 clocks) 
 399               			POP   R3                                          ;restore R3             (  2 clocks) 
 400               			POP   R2                                          ;restore R2             (  2 clocks) 
 401               			POP   R1                                          ;restore R1             (  2 clocks) 
 402               			POP   R0                                          ;fetch SREG             (  2 clocks) 
 403               			OUT   IOSREG             , R0                     ;load SREG              (  1 clock ) 
 404               			POP   R0                                          ;restore R0             (  2 clocks) 
 405               	.endm                                                                                          
 406               	;;===================================context restore end====================================;; 
