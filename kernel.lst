 587               	;;==============================increment tick counter starting=============================;; 
 588               	;used registers          : R18, R19                                                            
 589               	;arg registers           : None                                                                
 590               	;return registers        : None                                                                
 591               	;unsafe access registers : R18, R19                                                            
 592               	.macro  KER_TICK_INCREMENT                                ;total 3.25uS @8MHz     ( 27 clocks) 
 593               	        #ifdef KER_TICK_CNTR_ENABLE                                                            
 594               	        LDI   R18                , 0x01                   ;load 1                 (  1 clock ) 
 595               			LDS   R19                , KerBase+OFB_TICK0      ;load Byte0             (  2 clocks) 
 596               			ADD   R19                , R18                    ;add 1 with current val (  1 clock ) 
 597               			STS   KerBase+OFB_TICK0  , R19                    ;set Byte0              (  2 clocks) 
 598               			LDI   R18                , 0x00                   ;clear reg              (  1 clock ) 
 599               			LDS   R19                , KerBase+OFB_TICK1      ;load Byte1             (  2 clocks) 
 600               			ADC   R19                , R18                    ;add carry with Byte1   (  1 clock ) 
 601               			STS   KerBase+OFB_TICK1  , R19                    ;set Byte1              (  2 clocks) 
 602               			LDS   R19                , KerBase+OFB_TICK2      ;load Byte2             (  2 clocks) 
 603               			ADC   R19                , R18                    ;add carry with Byte2   (  1 clock ) 
 604               			STS   KerBase+OFB_TICK2  , R19                    ;set Byte2              (  2 clocks) 
 605               			LDS   R19                , KerBase+OFB_TICK3      ;load Byte3             (  2 clocks) 
 606               			ADC   R19                , R18                    ;add carry with Byte3   (  1 clock ) 
 607               			STS   KerBase+OFB_TICK3  , R19                    ;set Byte3              (  2 clocks) 
 608               			LDS   R19                , KerBase+OFB_TICK4      ;load Byte4             (  2 clocks) 
 609               			ADC   R19                , R18                    ;add carry with Byte4   (  1 clock ) 
 610               			STS   KerBase+OFB_TICK4  , R19                    ;set Byte4              (  2 clocks) 
 611               			#endif                                                                                 
 612               	.endm                                                                                          
 613               	;;=================================increment tick counter end===============================;; 
