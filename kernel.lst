 591               	Kernel_Task_Idle:                                                                              
 592:kernel.S      **** 	    KER_SLEEP_INIT                                    ;sleep init             (  5 clocks) 
 593               	    IDLE_LOOP:                                            ;forever loop                        
 594               		    ;KER_DISABLE_ANALOG_DOMAIN                         ;disable adc, ac        ( 10 clocks) 
 595:kernel.S      **** 		LDI   R24   , 100
 596:kernel.S      **** 		CALL  Kernel_Task_Sleep
 597:kernel.S      **** 		JMP   IDLE_LOOP                                   ;jump to loop start     (  2 clocks) 
