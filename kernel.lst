 455               	.macro  KER_RUN_SCHEDULER                                 ;total 0.25uS @8MHz     (  2 clocks) 
 456               			LDS   R18                , KerTID                 ;load val               (  2 clocks) 
 457               			INC   R18                                         ;increment val          (  1 clock ) 
 458               			LDS   R19                , KerNTSK                ;load ntask             (  2 clocks) 
 459               			CP    R18                , R19                    ;compare val            (  1 clock ) 
 460               			BRLO  _KER_SCH_ASSN\@
 461               			LDI   R18                , 0x00                   ;roll back              (  1 clock ) 
 462               			STS   KerTID             , R18                    ;save val               (  2 clocks)  
 463               		_KER_SCH_ASSN\@:
 464               			LSL   R18                                         ;multiply by 2          (  1 clock ) 
 465               			LDI   R30                , lo8(KerSleep)          ;load sleep reg low     (  1 clock ) 
 466               			LDI   R31                , hi8(KerSleep)          ;load sleep reg high    (  1 clock ) 
 467               			ADD   R30                , R18                    ;add                    (  1 clock ) 
 468               			LDI   R18                , 0x00                   ;set val 0              (  1 clock ) 
 469               			ADC   R31                , R18                    ;add with carry         (  1 clock ) 
 470               			LD    R18                , Z                      ;load val               (  1 clock ) 
 471               			STS   KerLST             , R18                    ;store val              (  2 clocks)  
 472               	.endm                                                                                          
