 127               	;;===============================timer2 async init starting=================================;; 
 128               	;used registers          : R18, R19                                                            
 129               	;arg registers           : None                                                                
 130               	;return registers        : None                                                                
 131               	;unsafe access registers : R18, R19                                                            
 132               	.macro  KER_TIMER2_ASYNC_INIT                             ;~9.13uS @8MHz          (~73 clocks) 
 133               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 134               			STS   SRTCCR2B           , R18                    ;stop timer             (  2 clocks) 
 135               			STS   SRTIMSK2           , R18                    ;clear TIMSK2           (  2 clocks) 
 136               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 137               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 138               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 139               			STS   SROCR2A            , R18                    ;clear compare reg      (  2 clocks) 
 140               			STS   SROCR2B            , R18                    ;clear compare reg      (  2 clocks) 
 141               			STS   SRTCCR2A           , R18                    ;clear controlA reg     (  2 clocks) 
 142               			LDI   R18                , 0x03                   ;prescaler 3            (  1 clock ) 
 143               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 144               			LDI   R18                , 0x00                   ;clear reg              (  1 clock ) 
 145               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 146               		_KER_TC2_AUB\@:                                                                            
 147               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 148               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 149               			BRNE  _KER_TC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 150               		_KER_TC2_BUB\@:                                                                            
 151               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 152               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 153               			BRNE  _KER_TC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 154               		_KER_OC2_AUB\@:                                                                            
 155               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 156               	        ANDI  R18                , 0x08                   ;check bit OR2AUB       (  1 clock ) 
 157               			BRNE  _KER_OC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 158               		_KER_OC2_BUB\@:                                                                            
 159               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 160               	        ANDI  R18                , 0x04                   ;check bit OCR2BUB      (  1 clock ) 
 161               			BRNE  _KER_OC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 162               		_KER_TC2_UB\@:                                                                             
 163               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 164               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 165               			BRNE  _KER_TC2_UB\@                               ;wait until UB cleared  (  2 clocks) 
 166               		_KER_TC2_TOV2\@:                                                                           
 167               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 168               	        ANDI  R18                , 0x01                   ;check bit TOV2         (  1 clock ) 
 169               	        BREQ  _KER_TC2_OCF2A\@                            ;bit cleared, jump next (  2 clocks) 
 170               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 171               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 172               	    _KER_TC2_OCF2A\@:                                                                          
 173               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 174               	        ANDI  R18                , 0x02                   ;check bit OCF2A        (  1 clock ) 
 175               	        BREQ  _KER_TC2_OCF2B\@                            ;bit cleared, jump next (  2 clocks) 
 176               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 177               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 178               		_KER_TC2_OCF2B\@:                                                                          
 179               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 180               	        ANDI  R18                , 0x04                   ;check bit OCF2B        (  1 clock ) 
 181               	        BREQ  _KER_TC2_INTEN\@                            ;bit cleared, jump next (  2 clocks) 
 182               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 183               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 184               	    _KER_TC2_INTEN\@:                                                                          
 185               			LDI   R18                , 0x01                   ;set TOIE2 bit          (  1 clock ) 
 186               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 187               	.endm                                                                                          
 188               	;;=================================timer2 async init end====================================;; 
