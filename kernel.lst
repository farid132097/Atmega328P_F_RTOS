 662               	;;=================================pop msp & zp starting====================================;; 
 663               	;used registers          : R18, R19, R26(XL), R27(XH), R30(ZL), R31(ZH)                        
 664               	;arg registers           : None                                                                
 665               	;return registers        : None                                                                
 666               	;unsafe access registers : R18, R19, R26(XL), R27(XH), R30(ZL), R31(ZH)                        
 667               	.macro  KER_POP_MSP_ZP                                    ;total 2.25uS @8MHz     ( 18 clocks) 
 668               			LDS   R26                , KerSSZ+OFM_MSPI+0      ;load val low           (  2 clocks) 
 669               			LDS   R27                , KerSSZ+OFM_MSPI+1      ;load val high          (  2 clocks) 
 670               			LD    R31                , -X                     ;load ZH                (  2 clocks) 
 671               			LD    R30                , -X                     ;load ZL                (  2 clocks) 
 672               			LD    R19                , -X                     ;load main SPH          (  2 clocks) 
 673               			LD    R18                , -X                     ;load main SPL          (  2 clocks) 
 674               			OUT   IOSPL              , R18                    ;set SPL                (  1 clock ) 
 675               			OUT   IOSPH              , R19                    ;set SPH                (  1 clock ) 
 676               			STS   KerSSZ+OFM_MSPI+0  , R26                    ;store new index        (  2 clocks) 
 677               			STS   KerSSZ+OFM_MSPI+1  , R27                    ;store new index        (  2 clocks) 
 678               	.endm                                                                                          
 679               	;;====================================pop msp & zp end======================================;; 
