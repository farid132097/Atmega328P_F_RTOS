 362               	.macro  KER_MSP_ZP_SAVE                                   ;total 1.25uS @8MHz     ( 10 clocks) 
 363               	        IN    R18                , IOSPL                  ;load SPL               (  1 clock ) 
 364               			IN    R19                , IOSPH                  ;load SPH               (  1 clock ) 
 365               			STS   KerMSPZP+0         , R18                    ;store SPL              (  2 clocks) 
 366               			STS   KerMSPZP+1         , R19                    ;store SPH              (  2 clocks) 
 367               			STS   KerMSPZP+2         , R30                    ;store ZL               (  2 clocks) 
 368               			STS   KerMSPZP+3         , R31                    ;store ZH               (  2 clocks) 
 369               	.endm                                                                                          
