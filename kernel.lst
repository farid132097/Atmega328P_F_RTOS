 567               	;;===============================save current task sp starting==============================;; 
 568               	;used registers          : R18, R19, R30(ZL), R31(ZH)                                          
 569               	;arg registers           : None                                                                
 570               	;return registers        : None                                                                
 571               	;unsafe access registers : R18, R19, R30(ZL), R31(ZH)                                          
 572               	.macro  KER_SAVE_CURR_TASK_SP                             ;total 1.75uS @8MHz     ( 14 clocks) 
 573               			LDI   R30                , lo8(KerPSP)            ;fetch base pos low     (  1 clock ) 
 574               			LDI   R31                , hi8(KerPSP)            ;fetch base pos high    (  1 clock ) 
 575               			KER_CALC_ADDR_OFF_WORD                            ;calc offset            (  6 clocks) 
 576               			IN    R18                , IOSPL                  ;fetch SPL0             (  1 clock ) 
 577               			IN    R19                , IOSPH                  ;fetch SPH0             (  1 clock ) 
 578               			STD   Z+0                , R18                    ;store SPL at ZP+0      (  2 clocks) 
 579               			STD   Z+1                , R19                    ;store SPH at ZP+1      (  2 clocks) 
 580               	.endm                                                                                          
