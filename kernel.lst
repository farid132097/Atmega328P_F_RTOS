 418               	.macro  KER_MSP_ZP_RESTORE                                ;total 7.88uS @8MHz     ( 83 clocks) 
 419               			LDS   R31                , KerMSPZP+3             ;fetch ZH               (  2 clocks) 
 420               			LDS   R30                , KerMSPZP+2             ;fetch ZL               (  2 clocks) 
 421               			LDS   R19                , KerMSPZP+1             ;fetch SPH              (  2 clocks) 
 422               			LDS   R18                , KerMSPZP+0             ;fetch SPL              (  2 clocks) 
 423               			OUT   IOSPL              , R18                    ;load SPL               (  1 clock ) 
 424               			OUT   IOSPH              , R19                    ;load SPH               (  1 clock ) 
 425               	.endm                                                                                          
