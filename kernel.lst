 354               	.macro  KER_SAVE_R1_R31                                   ;total 7.88uS @8MHz     ( 63 clocks) 
 355               			PUSH  R1                                          ;save R1                (  2 clocks) 
 356               			CLR   R1                                          ;clear R1               (  1 clock ) 
