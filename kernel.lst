 195               	.macro  KER_TIMER_RELOAD                                  ;0.5uS @8MHz            (  4 clocks) 
 196               	        LDS   R18                , KerLST                 ;fetch lowst sleep time (  2 clocks) 
 197               			STS   SRTCNT2            , R18                    ;set val                (  2 clocks) 
 198               	.endm                                                                                          
