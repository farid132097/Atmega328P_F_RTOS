 485               	    __vector_9:                                           ;total 40.00uS @8MHz    (344 clocks) 
 486:kernel.S      **** 	    KER_DEBUG_PIN_SET                                 ;debug pin set          (  2 clocks) 
 487:kernel.S      **** 		KER_CONTEXT_SAVE                                  ;save context           ( 83 clocks) 
 488               	
 489:kernel.S      **** 		LDI  R18,  0x00
 490:kernel.S      **** 		STS  SRTIMSK2, R18
