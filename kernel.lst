 628               	Kernel_Init:                                              ;total 39.75uS @8MHz    (318 clocks) 
 629:kernel.S      ****         CLI                                               ;clear interrupt        (  1 clock ) 
 630:kernel.S      **** 		KER_MSP_ZP_SAVE                                   ;push MSP and ZP        ( 18 clocks) 
 631:kernel.S      **** 		KER_DEBUG_PIN_INIT                                ;debug pin init         (  4 clocks) 
 632:kernel.S      **** 		CALL  Kernel_Vars_Init                            ;variables init         ( 15 clocks) 
 633               			
 634:kernel.S      **** 		KER_MSP_ZP_RESTORE                                ;pop MSP and ZP         ( 18 clocks) 
 635:kernel.S      **** 		LDI   R24                , lo8(Kernel_Task_Idle)  ;load func addr low     (  1 clock ) 
 636:kernel.S      **** 		LDI   R25                , hi8(Kernel_Task_Idle)  ;load func addr high    (  1 clock ) 
 637:kernel.S      **** 		LSR   R25                                         ;right shift to divide  (  1 clock ) 
 638:kernel.S      **** 		ROR   R24                                         ;rotate right th carry  (  1 clock ) 
 639:kernel.S      **** 		LDI   R22                , 0xFF                   ;set max val            (  1 clock ) 
 640:kernel.S      **** 		CALL  Kernel_Task_Create
 641:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) 
