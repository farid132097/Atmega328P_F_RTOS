 200               	.macro  KER_TIMER_RELOAD                                  ;0.5uS @8MHz            (  4 clocks) 
 201               	        LDS   R18                , KerBase+OFB_LST        ;fetch lowst sleep time (  2 clocks) 
 202               			STS   SRTCNT2            , R18                    ;set val                (  2 clocks) 
 203               	.endm                                                                                          
