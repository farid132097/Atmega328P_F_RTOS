 729               	;;============================current task priority starting================================;; 
 730               	;used registers          : R18, R24, R30(ZL), R31(ZH)                                          
 731               	;arg registers           : None                                                                
 732               	;return registers        : R24 (Current task priority)                                         
 733               	;unsafe access registers : R18, R24, R30(ZL), R31(ZH)                                          
 734               	.macro  KER_CURR_TASK_PRIO                                ;total 1.13uS @8MHz     (  9 clocks) 
 735               			LDI    R30               , lo8(KerSchPr)          ;load low addr          (  1 clock ) 
 736               			LDI    R31               , hi8(KerSchPr)          ;load high addr         (  1 clock ) 
 737               			LDI    R18               , 0x00                   ;clear reg, for carry   (  1 clock ) 
 738               			LDS    R24               , KerBase+OFB_TID        ;load task id           (  2 clocks) 
 739               	        ADD    R30               , R24                    ;add low addr           (  1 clock ) 
 740               			ADC    R31               , R18                    ;add carry if any       (  1 clock ) 
 741               			LD     R24               , Z                      ;load current tid prio  (  2 clocks) 
 742               	.endm                                                                                          
 743               	;;==============================current task priority end===================================;; 
 744               	
 745               	
 746               	
 747               	
 748               	
 749               	;;================================run scheduler starting====================================;; 
 750               	;used registers          : R18, R19, R20, R21, R24, R25, R30(ZL), R31(ZH)                      
 751               	;arg registers           : R24 (SCH_MODE_HANDLER/SCH_MODE_THREAD)                              
 752               	;return registers        : None                                                                
 753               	;unsafe access registers : R18, R19, R20, R21, R24, R25, R30(ZL), R31(ZH)                      
 754               	.macro  KER_RUN_SCHEDULER                                 ;total 13.25uS @8MHz    (106 clocks) 
 755               			LDI    R18               , 0xFF                   ;set 0xff               (  1 clock ) 
 756               			STS    KerBase+OFB_LPR   , R18                    ;lowest priority        (  2 clocks) 
 757               			LDI    R18               , 0x00                   ;start from 0           (  1 clock ) 
 758               			STS    KerBase+OFB_PTID  , R18                    ;highest prio tid=0     (  2 clocks) 
 759               			MOV    R21               , R24                    ;copy sch mode          (  1 clock ) 
 760               		_KER_SCH_LOOP\@:                                                                           
 761               		    ;store task id to run from KER_DEC_SLP_TIMEOUT                                         
 762               			STS    KerBase+OFB_TID   , R18                    ;store task id          (  2 clocks) 
 763               	        ;sleep time decrement, update ready/blocked status                                     
 764               			MOV    R24               , R21                    ;restore sch mode       (  1 clock ) 
 765               			KER_SLP_TIME_MGNT                                 ;update return vars     ( 52 clocks) 
 766               	        CPI    R24               , TASK_READY             ;compare                (  1 clock ) 
 767               	        BREQ   _KER_CALC_PRIO\@                           ;calc priority if ready (  2 clocks) 
 768               			CPI    R24               , TASK_CONS_LAT          ;compare                (  1 clock ) 
 769               	        BREQ   _KER_CALC_PRIO\@                           ;calc priority if c_lat (  2 clocks) 
 770               	        RJMP   _KER_SCH_NEXT\@                            ;skip if !ready|c_lat   (  2 clocks) 
 771               		_KER_CALC_PRIO\@:                                                                          
 772               			KER_CURR_TASK_PRIO                                ;get task prio ->R24    (  9 clocks) 
 773               	        ;compare current task priority with lowest priority found so far                       
 774               			LDS    R18               , KerBase+OFB_LPR        ;load lowest priority   (  2 clocks) 
 775               			CP     R24               , R18                    ;compare                (  1 clock ) 
 776               			BRSH   _KER_SCH_NEXT\@                            ;if prio>=lowest prio   (  2 clocks) 
 777               			;found new lowest priority                                                             
 778               			STS    KerBase+OFB_LPR   , R24                    ;save lowest priority   (  2 clocks) 
 779               			LDS    R18               , KerBase+OFB_TID        ;load task id           (  2 clocks) 
 780               			STS    KerBase+OFB_PTID  , R18                    ;save lowest priority   (  2 clocks) 
 781               	                                                                                               
 782               	    _KER_SCH_NEXT\@:                                                                           
 783               		    LDS    R18               , KerBase+OFB_TID        ;load task id           (  2 clocks) 
 784               			INC    R18                                        ;increment by 1         (  1 clock ) 
 785               			LDS    R19               , KerBase+OFB_NTSK       ;load ntask             (  2 clocks) 
 786               			CP     R18               , R19                    ;compare with ntask     (  2 clocks) 
 787               			BRSH   _KER_SCH_EXIT\@                            ;if task_id>=ntask      (  2 clocks) 
 788               			RJMP   _KER_SCH_LOOP\@                            ;jump to entry          (  2 clocks) 
 789               		_KER_SCH_EXIT\@:                                                                           
 790               	        LDS    R18               , KerBase+OFB_PTID       ;load high prio task id (  2 clocks) 
 791               			STS    KerBase+OFB_TID   , R18                    ;for test only          (  2 clocks) 
 792               	.endm                                                                                          
 793               	;;===================================run scheduler end======================================;; 
 794               	
