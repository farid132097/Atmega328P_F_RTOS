 251               	.macro  KER_CONTEXT_SAVE                                  ;total 7.88uS @8MHz     ( 83 clocks) 
 252               	        PUSH  R0                                          ;push R0                (  2 clocks) 
 253               			IN    R0                 , IOSREG                 ;save SREG              (  1 clock ) 
 254               			CLI                                               ;clear interrupt        (  1 clock ) 
 255               			PUSH  R0                                          ;save SREG              (  2 clocks) 
 256               			PUSH  R1                                          ;save R1                (  2 clocks) 
 257               			CLR   R1                                          ;clear R1               (  1 clock ) 
 258               			PUSH  R2                                          ;save R2                (  2 clocks) 
 259               			PUSH  R3                                          ;save R3                (  2 clocks) 
 260               			PUSH  R4                                          ;save R4                (  2 clocks) 
 261               			PUSH  R5                                          ;save R5                (  2 clocks) 
 262               			PUSH  R6                                          ;save R6                (  2 clocks) 
 263               			PUSH  R7                                          ;save R7                (  2 clocks) 
 264               			PUSH  R8                                          ;save R8                (  2 clocks) 
 265               			PUSH  R9                                          ;save R9                (  2 clocks) 
 266               			PUSH  R10                                         ;save R10               (  2 clocks) 
 267               			PUSH  R11                                         ;save R11               (  2 clocks) 
 268               			PUSH  R12                                         ;save R12               (  2 clocks) 
 269               			PUSH  R13                                         ;save R13               (  2 clocks) 
 270               			PUSH  R14                                         ;save R14               (  2 clocks) 
 271               			PUSH  R15                                         ;save R15               (  2 clocks) 
 272               			PUSH  R16                                         ;save R16               (  2 clocks) 
 273               			PUSH  R17                                         ;save R17               (  2 clocks) 
 274               			PUSH  R18                                         ;save R18               (  2 clocks) 
 275               			PUSH  R19                                         ;save R19               (  2 clocks) 
 276               			PUSH  R20                                         ;save R20               (  2 clocks) 
 277               			PUSH  R21                                         ;save R21               (  2 clocks) 
 278               			PUSH  R22                                         ;save R22               (  2 clocks) 
 279               			PUSH  R23                                         ;save R23               (  2 clocks) 
 280               			PUSH  R24                                         ;save R24               (  2 clocks) 
 281               			PUSH  R25                                         ;save R25               (  2 clocks) 
 282               			PUSH  R26                                         ;save R26               (  2 clocks) 
 283               			PUSH  R27                                         ;save R27               (  2 clocks) 
 284               			PUSH  R28                                         ;save R28               (  2 clocks) 
 285               			PUSH  R29                                         ;save R29               (  2 clocks) 
 286               			PUSH  R30                                         ;save R30               (  2 clocks) 
 287               			PUSH  R31                                         ;save R31               (  2 clocks) 
 288               			LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 289               			LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 290               			LDS   R18                , KerTID                 ;fetch task id          (  2 clocks) 
 291               			LSL   R18                                         ;left shift to multiply (  1 clock ) 
 292               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 293               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 294               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 295               			IN    R18                , IOSPL                  ;fetch SPL0             (  1 clock ) 
 296               			IN    R19                , IOSPH                  ;fetch SPH0             (  1 clock ) 
 297               			STD   Z+0                , R18                    ;store SPL at ZP+0      (  2 clocks) 
 298               			STD   Z+1                , R19                    ;store SPH at ZP+1      (  2 clocks) 
 299               	.endm                                                                                          
