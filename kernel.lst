 331               	;;=================================context restore starting=================================;; 
 332               	;used registers          : R0~R31                                                              
 333               	;arg registers           : None                                                                
 334               	;return registers        : None                                                                
 335               	;unsafe access registers : None                                                                
 336               	.macro  KER_CONTEXT_RESTORE                               ;total 8.38uS @8MHz     ( 81 clocks) 
 337               	        LDI   R30                , lo8(KerTSP)            ;fetch base pos low     (  1 clock ) 
 338               			LDI   R31                , hi8(KerTSP)            ;fetch base pos high    (  1 clock ) 
 339               			LDS   R18                , KerTID                 ;fetch task_id          (  2 clocks) 
 340               			LSL   R18                                         ;left shift to multiply (  1 clock ) 
 341               			ADD   R30                , R18                    ;add offset to array    (  1 clock ) 
 342               			LDI   R18                , 0x00                   ;clear for carry prop   (  1 clock ) 
 343               			ADC   R31                , R18                    ;add carry if any       (  1 clock ) 
 344               			LDD   R18                , Z+0                    ;load SPL at ZP         (  2 clocks) 
 345               			LDD   R19                , Z+1                    ;load SPH at ZP         (  2 clocks) 
 346               			OUT   IOSPL              , R18                    ;load SPL0              (  1 clock ) 
 347               			OUT   IOSPH              , R19                    ;load SPH0              (  1 clock ) 
 348               			POP   R31                                         ;restore R31            (  2 clocks) 
 349               			POP   R30                                         ;restore R30            (  2 clocks) 
 350               			POP   R29                                         ;restore R29            (  2 clocks) 
 351               			POP   R28                                         ;restore R28            (  2 clocks) 
 352               			POP   R27                                         ;restore R27            (  2 clocks) 
 353               			POP   R26                                         ;restore R26            (  2 clocks) 
 354               			POP   R25                                         ;restore R25            (  2 clocks) 
 355               			POP   R24                                         ;restore R24            (  2 clocks) 
 356               			POP   R23                                         ;restore R23            (  2 clocks) 
 357               			POP   R22                                         ;restore R22            (  2 clocks) 
 358               			POP   R21                                         ;restore R21            (  2 clocks) 
 359               			POP   R20                                         ;restore R20            (  2 clocks) 
 360               			POP   R19                                         ;restore R19            (  2 clocks) 
 361               			POP   R18                                         ;restore R18            (  2 clocks) 
 362               			POP   R17                                         ;restore R17            (  2 clocks) 
 363               			POP   R16                                         ;restore R16            (  2 clocks) 
 364               			POP   R15                                         ;restore R15            (  2 clocks) 
 365               			POP   R14                                         ;restore R14            (  2 clocks) 
 366               			POP   R13                                         ;restore R13            (  2 clocks) 
 367               			POP   R12                                         ;restore R12            (  2 clocks) 
 368               			POP   R11                                         ;restore R11            (  2 clocks) 
 369               			POP   R10                                         ;restore R10            (  2 clocks) 
 370               			POP   R9                                          ;restore R9             (  2 clocks) 
 371               			POP   R8                                          ;restore R8             (  2 clocks) 
 372               			POP   R7                                          ;restore R7             (  2 clocks) 
 373               			POP   R6                                          ;restore R6             (  2 clocks) 
 374               			POP   R5                                          ;restore R5             (  2 clocks) 
 375               			POP   R4                                          ;restore R4             (  2 clocks) 
 376               			POP   R3                                          ;restore R3             (  2 clocks) 
 377               			POP   R2                                          ;restore R2             (  2 clocks) 
 378               			POP   R1                                          ;restore R1             (  2 clocks) 
 379               			POP   R0                                          ;fetch SREG             (  2 clocks) 
 380               			OUT   IOSREG             , R0                     ;load SREG              (  1 clock ) 
 381               			POP   R0                                          ;restore R0             (  2 clocks) 
 382               	.endm                                                                                          
 383               	;;===================================context restore end====================================;; 
