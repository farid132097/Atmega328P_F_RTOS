 616               	Kernel_Task_Idle:                                                                              
 617:kernel.S      **** 	    KER_SLEEP_INIT                                    ;sleep init             (  5 clocks) 
 618               	    IDLE_LOOP:                                            ;forever loop                        
 619               		    ;KER_DISABLE_ANALOG_DOMAIN                         ;disable adc, ac        ( 10 clocks) 
 620:kernel.S      **** 		LDI   R24   , 100
 621:kernel.S      **** 		CALL  Kernel_Task_Sleep
 622:kernel.S      **** 		JMP   IDLE_LOOP                                   ;jump to loop start     (  2 clocks) 
