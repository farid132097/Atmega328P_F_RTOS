 669               	Kernel_Task_Sleep_Test:                                   ;total 37.25uS @8MHz    (298 clocks) 
 670:kernel.S      **** 		LDI   R30                , lo8(KerSleep)          ;fetch base pos low     (  1 clock ) 
 671:kernel.S      **** 		LDI   R31                , hi8(KerSleep)          ;fetch base pos high    (  1 clock ) 
 672:kernel.S      **** 		LDS   R18                , KerTID                 ;load TID               (  1 clock ) 
 673:kernel.S      **** 		ADD   R30                , R18                    ;add regs               (  1 clock ) 
 674:kernel.S      **** 		LDI   R18                , 0x00                   ;clear reg              (  1 clock ) 
 675:kernel.S      **** 		ADC   R31                , R18                    ;add regs with carry    (  1 clock ) 
 676:kernel.S      **** 		ST    Z                  , R24                    ;store val              (  2 clocks)  
 677:kernel.S      **** 		RET                                               ;return from subroutine (  4 clocks) ...
