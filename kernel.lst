 194               	;;=============================timer2 tcnt update busy starting=============================;; 
 195               	;used registers          : R18                                                                 
 196               	;arg registers           : None                                                                
 197               	;return registers        : None                                                                
 198               	;unsafe access registers : R18                                                                 
 199               	.macro  KER_TIMER2_TCNT2_UB                               ;~9.13uS @8MHz          (~73 clocks) 
 200               		_KER_TMR2_UB\@:                                                                            
 201               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 202               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 203               			BRNE  _KER_TMR2_UB\@                              ;wait until UB cleared  (  2 clocks) 
 204               	.endm                                                                                          
 205               	;;==============================timer2 tcnt update busy end==================================;; 
