 705:kernel.S      **** 		ROR   R24                                         ;rotate right th carry  (  1 clock ) 
 706:kernel.S      **** 		LDI   R22                , 0xFF                   ;set max val            (  1 clock ) 
 707:kernel.S      **** 		CALL  Kernel_Task_Create                          ;init idle task         (172 clocks) 
