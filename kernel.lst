  26               	;;===========================define hardware reg address starting===========================;; 
  27               	;SRAM Mapped Addresses, LDS/STS can be used                                                    
  28               	.equ     SRASSR  ,        0xB6                            ;manually defined ASSR in SRAM       
  29               	.equ     SROCR2B ,        0xB4                            ;manually defined OCR2B in SRAM      
  30               	.equ     SROCR2A ,        0xB3                            ;manually defined OCR2A in SRAM      
  31               	.equ     SRTCNT2 ,        0xB2                            ;manually defined TNCT2 in SRAM      
  32               	.equ     SRTCCR2B,        0xB1                            ;manually defined TCCR2B in SRAM     
  33               	.equ     SRTCCR2A,        0xB0                            ;manually defined TCCR2A in SRAM     
  34               	.equ     SRADCSRA,        0x7A                            ;manually defined ADCSRA in SRAM     
  35               	.equ     SRTIMSK2,        0x70                            ;manually defined TIMSK2 in SRAM     
  36               	.equ     SRCLKPR ,        0x61                            ;manually defined CLKPR in SRAM      
  37               	.equ     SRSREG  ,        0x5F                            ;manually defined SREG in SRAM       
  38               	.equ     SRSPH   ,        0x5E                            ;manually defined SPH in SRAM        
  39               	.equ     SRSPL   ,        0x5D                            ;manually defined SPL in SRAM        
  40               	.equ     SRMCUCR ,        0x55                            ;manually defined MCUCR in SRAM      
  41               	.equ     SRMCUSR ,        0x54                            ;manually defined MCUSR in SRAM      
  42               	.equ     SRSMCR  ,        0x53                            ;manually defined SMCR in SRAM       
  43               	.equ     SRACSR  ,        0x50                            ;manually defined ACSR in SRAM       
  44               	.equ     SRTIFR2 ,        0x37                            ;manually defined TIFR2 in SRAM      
  45               	;IO Mapped Addresses, IN/OUT commands can be used                                              
  46               	.equ     IOSREG  ,        0x3F                            ;manually defined SREG in IO         
  47               	.equ     IOSPH   ,        0x3E                            ;manually defined SPH in IO          
  48               	.equ     IOSPL   ,        0x3D                            ;manually defined SPL in IO          
  49               	.equ     IOMCUCR ,        0x35                            ;manually defined MCUCR in IO        
  50               	.equ     IOMCUSR ,        0x34                            ;manually defined MCUSR in IO        
  51               	.equ     IOSMCR  ,        0x33                            ;manually defined SMCR in IO         
  52               	.equ     IOTIFR2 ,        0x17                            ;manually defined TIFR2 in IO        
  53               	;;==============================define hardware reg address end=============================;; 
