 389               	;;===================================msp zp save starting===================================;; 
 390               	;used registers          : R18, R19, R30, R31                                                  
 391               	;arg registers           : None                                                                
 392               	;return registers        : None                                                                
 393               	;unsafe access registers : None                                                                
 394               	.macro  KER_MSP_ZP_SAVE                                   ;total 1.25uS @8MHz     ( 10 clocks) 
 395               	        IN    R18                , IOSPL                  ;load SPL               (  1 clock ) 
 396               			IN    R19                , IOSPH                  ;load SPH               (  1 clock ) 
 397               			STS   KerMSPZP+0         , R18                    ;store SPL              (  2 clocks) 
 398               			STS   KerMSPZP+1         , R19                    ;store SPH              (  2 clocks) 
 399               			STS   KerMSPZP+2         , R30                    ;store ZL               (  2 clocks) 
 400               			STS   KerMSPZP+3         , R31                    ;store ZH               (  2 clocks) 
 401               	.endm                                                                                          
