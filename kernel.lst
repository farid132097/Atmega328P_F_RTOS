 110               	;;=================================timer2 disable starting==================================;; 
 111               	;used registers          : R18                                                                 
 112               	;arg registers           : None                                                                
 113               	;return registers        : None                                                                
 114               	;unsafe access registers : R18                                                                 
 115               	.macro  KER_TIMER2_DISABLE                                ;1.75uS @8MHz           ( 14 clocks) 
 116               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 117               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 118               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 119               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 120               			STS   SROCR2B            , R18                    ;clear OCR2B            (  2 clocks) 
 121               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 122               	.endm                                                                                          
 123               	;;==================================timer2 disable end======================================;; 
