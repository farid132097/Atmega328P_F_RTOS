 639               	;;================================push msp & zp starting====================================;; 
 640               	;used registers          : R18, R19, R26(XL), R27(XH), R30(ZL), R31(ZH)                        
 641               	;arg registers           : None                                                                
 642               	;return registers        : None                                                                
 643               	;unsafe access registers : R18, R19, R26(XL), R27(XH), R30(ZL), R31(ZH)                        
 644               	.macro  KER_PUSH_MSP_ZP                                   ;total 2.25uS @8MHz     ( 18 clocks) 
 645               	        LDS   R26                , KerSSZ+OFM_MSPI+0      ;load val low           (  2 clocks) 
 646               			LDS   R27                , KerSSZ+OFM_MSPI+1      ;load val high          (  2 clocks) 
 647               			IN    R18                , IOSPL                  ;copy                   (  1 clock ) 
 648               			IN    R19                , IOSPH                  ;copy                   (  1 clock ) 
 649               			ST    X+                 , R18                    ;store main SPL         (  2 clocks) 
 650               	        ST    X+                 , R19                    ;store main SPH         (  2 clocks) 
 651               			ST    X+                 , R30                    ;store main ZL          (  2 clocks) 
 652               			ST    X+                 , R31                    ;store main ZH          (  2 clocks) 
 653               			STS   KerSSZ+OFM_MSPI+0  , R26                    ;store new index        (  2 clocks) 
 654               			STS   KerSSZ+OFM_MSPI+1  , R27                    ;store new index        (  2 clocks) 
 655               	.endm                                                                                          
 656               	;;===================================push msp & zp end======================================;; 
