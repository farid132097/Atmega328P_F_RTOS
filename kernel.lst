 123               	;;===============================timer2 async init starting=================================;; 
 124               	;used registers          : R18, R19                                                            
 125               	;arg registers           : None                                                                
 126               	;return registers        : None                                                                
 127               	;unsafe access registers : R18, R19                                                            
 128               	.macro  KER_TIMER2_ASYNC_INIT                             ;~9.13uS @8MHz          (~73 clocks) 
 129               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 130               			STS   SRTCCR2B           , R18                    ;stop timer             (  2 clocks) 
 131               			STS   SRTIMSK2           , R18                    ;clear TIMSK2           (  2 clocks) 
 132               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 133               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 134               			LDI   R18                , 0x00                   ;clear interrupts       (  1 clock ) 
 135               			STS   SROCR2A            , R18                    ;clear compare reg      (  2 clocks) 
 136               			STS   SROCR2B            , R18                    ;clear compare reg      (  2 clocks) 
 137               			STS   SRTCCR2A           , R18                    ;clear controlA reg     (  2 clocks) 
 138               			LDI   R18                , 0x03                   ;prescaler 3            (  1 clock ) 
 139               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 140               			LDI   R18                , 0x00                   ;clear reg              (  1 clock ) 
 141               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 142               		_KER_TC2_AUB\@:                                                                            
 143               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 144               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 145               			BRNE  _KER_TC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 146               		_KER_TC2_BUB\@:                                                                            
 147               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 148               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 149               			BRNE  _KER_TC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 150               		_KER_OC2_AUB\@:                                                                            
 151               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 152               	        ANDI  R18                , 0x08                   ;check bit OR2AUB       (  1 clock ) 
 153               			BRNE  _KER_OC2_AUB\@                              ;wait until AUB cleared (  2 clocks) 
 154               		_KER_OC2_BUB\@:                                                                            
 155               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 156               	        ANDI  R18                , 0x04                   ;check bit OCR2BUB      (  1 clock ) 
 157               			BRNE  _KER_OC2_BUB\@                              ;wait until BUB cleared (  2 clocks) 
 158               		_KER_TC2_UB\@:                                                                             
 159               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 160               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 161               			BRNE  _KER_TC2_UB\@                               ;wait until UB cleared  (  2 clocks) 
 162               		_KER_TC2_TOV2\@:                                                                           
 163               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 164               	        ANDI  R18                , 0x01                   ;check bit TOV2         (  1 clock ) 
 165               	        BREQ  _KER_TC2_OCF2A\@                            ;bit cleared, jump next (  2 clocks) 
 166               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 167               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 168               	    _KER_TC2_OCF2A\@:                                                                          
 169               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 170               	        ANDI  R18                , 0x02                   ;check bit OCF2A        (  1 clock ) 
 171               	        BREQ  _KER_TC2_OCF2B\@                            ;bit cleared, jump next (  2 clocks) 
 172               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 173               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 174               		_KER_TC2_OCF2B\@:                                                                          
 175               		    LDS   R18                , SRTIFR2                ;load TIFR2             (  2 clocks) 
 176               	        ANDI  R18                , 0x04                   ;check bit OCF2B        (  1 clock ) 
 177               	        BREQ  _KER_TC2_INTEN\@                            ;bit cleared, jump next (  2 clocks) 
 178               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 179               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 180               	    _KER_TC2_INTEN\@:                                                                          
 181               			LDI   R18                , 0x01                   ;set TOIE2 bit          (  1 clock ) 
 182               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 183               	.endm                                                                                          
 184               	;;=================================timer2 async init end====================================;; 
