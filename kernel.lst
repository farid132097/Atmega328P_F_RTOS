 112               	.macro  KER_TIMER2_ASYNC_INIT                             ;~9.13uS @8MHz          (~73 clocks) 
 113               			LDI   R18                , 0x00                   ;clear interrupt enbits (  1 clock ) 
 114               			STS   SRTIMSK2           , R18                    ;set val to TIMSK2      (  2 clocks) 
 115               			STS   SRTCCR2A           , R18                    ;set val to TCCR2A      (  2 clocks) 
 116               			STS   SRTCCR2B           , R18                    ;set val to TCCR2B      (  2 clocks) 
 117               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 118               			STS   SRTCNT2            , R18                    ;clear TCNT2            (  2 clocks) 
 119               			LDI   R18                , 0x20                   ;set AS2 bit            (  1 clock ) 
 120               			STS   SRASSR             , R18                    ;set val to ASSR        (  2 clocks) 
 121               			LDI   R18                , 0x03                   ;prescaler 32           (  1 clock ) 
 122               			STS   SRTCCR2B           , R18                    ;set prescaler          (  2 clocks) 
 123               		_KER_TCR2AUB\@:                                                                            
 124               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 125               	        ANDI  R18                , 0x02                   ;check bit TCR2AUB      (  1 clock ) 
 126               			BRNE  _KER_TCR2AUB\@                              ;wait until AUB cleared (  2 clocks) 
 127               		_KER_TCR2BUB\@:                                                                            
 128               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 129               	        ANDI  R18                , 0x01                   ;check bit TCR2BUB      (  1 clock ) 
 130               			BRNE  _KER_TCR2BUB\@                              ;wait until BUB cleared (  2 clocks) 
 131               		_KER_TCN2UB\@:                                                                             
 132               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 133               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 134               			BRNE  _KER_TCN2UB\@                               ;wait until UB cleared  (  2 clocks) 
 135               			LDI   R18                , 0x01                   ;set bit                (  1 clock ) 
 136               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 137               			LDI   R18                , 0x02                   ;set bit                (  1 clock ) 
 138               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 139               			LDI   R18                , 0x04                   ;set bit                (  1 clock ) 
 140               			STS   SRTIFR2            , R18                    ;set val                (  2 clocks) 
 141               	.endm                                                                                          
 142               	
 143               	
 144               	
 145               	
 146               	
 147               	 
 148               	.macro  KER_TIMER2_TCNT2_UB                               ;~9.13uS @8MHz          (~73 clocks) 
 149               		_KER_TMR2_UB\@:                                                                            
 150               		    LDS   R18                , SRASSR                 ;load ASSR              (  2 clocks) 
 151               	        ANDI  R18                , 0x10                   ;check bit TCNT2UB      (  1 clock ) 
 152               			BRNE  _KER_TMR2_UB\@                              ;wait until UB cleared  (  2 clocks) 
 153               	.endm                                                                                          
